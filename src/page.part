<style>
/* Layout: the CRT set is the hero; under it a cartridge-manual legend in three columns (controls | techniques | rules) that stacks on phones. Deliberately a single dark look. */
:root{
  --room:#0f0d13;
  --bezel:#1d1b22;
  --bezel-edge:#302c36;
  --paper:#efe5cb;
  --paper-dim:#a69c88;
  --amber:#f39a2b;
  --aka:#e2472f;
  --rule:#37323e;
  --key:#26232c;
  --font-display:"Silkscreen","Courier New",monospace;
  --font-body:"VT323","Courier New",monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{background:var(--room)}
body{margin:0;background:var(--room);color:var(--paper);font-family:var(--font-body);font-size:21px;line-height:1.2;padding-inline:16px;padding-block:20px 56px}
.wrap{max-width:1000px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
.mast{display:flex;align-items:baseline;justify-content:space-between;gap:6px 16px;flex-wrap:wrap}
.mast h1{margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(24px,4.4vw,36px);letter-spacing:.03em;line-height:1;text-wrap:balance}
.mast h1 b{color:var(--amber);font-weight:700}
.mast p{margin:0;color:var(--paper-dim);min-width:0}
.tv{background:linear-gradient(180deg,var(--bezel-edge),var(--bezel) 28%);border-radius:24px;padding:clamp(10px,2.2vw,22px);box-shadow:0 0 0 1px #000,0 24px 48px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.07)}
.screen{position:relative;aspect-ratio:16/9;max-width:100%;border-radius:16px;overflow:hidden;background:#000}
.screen canvas{display:block;width:100%;height:100%;image-rendering:pixelated;image-rendering:crisp-edges;touch-action:manipulation;cursor:pointer;outline:none}
.screen::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;background:repeating-linear-gradient(180deg,transparent 0 2px,rgba(0,0,0,.16) 2px 3px),radial-gradient(120% 100% at 50% 50%,transparent 62%,rgba(0,0,0,.5) 100%);box-shadow:inset 0 0 0 2px rgba(0,0,0,.8)}
.screen:fullscreen{border-radius:0;aspect-ratio:auto;display:flex;align-items:center;justify-content:center}
.screen:fullscreen canvas{width:min(100vw,calc(100vh * 16 / 9));height:auto;aspect-ratio:16/9}
.deck{display:flex;align-items:center;justify-content:space-between;gap:10px 16px;flex-wrap:wrap;padding-top:14px}
.brand{font-family:var(--font-display);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--paper-dim);display:flex;align-items:center;gap:8px}
.led{width:8px;height:8px;border-radius:50%;background:var(--aka);box-shadow:0 0 6px var(--aka)}
.btns{display:flex;gap:8px;flex-wrap:wrap}
.k{font-family:var(--font-display);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--paper);background:var(--key);border:1px solid #403a48;border-bottom-width:3px;border-radius:6px;padding:8px 12px;cursor:pointer}
.k:hover{border-color:var(--amber)}
.k:active{transform:translateY(1px);border-bottom-width:2px}
.k:focus-visible,.act:focus-visible,canvas:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
.k[aria-pressed="true"]{color:var(--amber)}
.pad{display:none;align-items:center;justify-content:space-between;gap:16px;padding-top:18px;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.pad.on{display:flex}
.dpad{position:relative;width:148px;height:148px;flex:none;touch-action:none}
.dpad span{position:absolute;background:var(--key);border:1px solid #403a48;pointer-events:none}
.dpad .h{left:0;right:0;top:50px;height:48px;border-radius:10px}
.dpad .v{top:0;bottom:0;left:50px;width:48px;border-radius:10px}
.dpad .c{left:51px;top:51px;width:46px;height:46px;border:0;background:#2e2a35}
.side{display:flex;flex-direction:column;align-items:flex-end;gap:14px}
.acts{display:flex;gap:14px;align-items:flex-start}
.act{width:76px;height:76px;border-radius:50%;border:2px solid #000;font-family:var(--font-display);font-size:11px;letter-spacing:.06em;color:#160f0b;cursor:pointer;touch-action:none;box-shadow:0 4px 0 #000}
.act.t{background:var(--amber);margin-top:26px}
.act.g{background:var(--aka);color:#fff4ea}
.act.down{transform:translateY(3px);box-shadow:0 1px 0 #000}
.manual{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:28px 32px}
.col{min-width:0;border-top:3px solid var(--amber);padding-top:12px}
.col:nth-child(2){border-top-color:var(--aka)}
.col:nth-child(3){border-top-color:var(--paper)}
.col h2{margin:0 0 10px;font-family:var(--font-display);font-size:15px;letter-spacing:.12em;text-transform:uppercase}
.note{color:var(--paper-dim);margin:12px 0 0}
.note b{color:var(--paper);font-weight:400}
table{width:100%;border-collapse:collapse}
th{font-family:var(--font-display);font-size:11px;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-dim);text-align:left;padding:0 14px 6px 0}
td{padding:5px 6px 5px 0;border-top:1px solid var(--rule);vertical-align:top}
kbd{font-family:var(--font-display);font-size:11px;display:inline-block;min-width:1.9em;text-align:center;padding:2px 5px;margin:1px;border:1px solid #4a4452;border-bottom-width:2px;border-radius:4px;background:var(--key);color:var(--paper)}
.moves{list-style:none;margin:0;padding:0}
.moves li{display:grid;grid-template-columns:5.2em minmax(0,1fr) auto;gap:0 10px;padding:6px 0;border-top:1px solid var(--rule);align-items:baseline}
.moves .in{font-family:var(--font-display);font-size:11px;color:var(--paper-dim);letter-spacing:.04em;grid-row:1/span 2}
.moves .jp{font-family:var(--font-display);font-size:12px;letter-spacing:.04em}
.moves .cz{grid-column:2;color:var(--paper-dim);font-size:19px}
.moves .pt{grid-row:1/span 2;grid-column:3;font-family:var(--font-display);font-size:10px;letter-spacing:.06em;padding:3px 6px;border-radius:4px;align-self:center;white-space:nowrap}
.pt.i{background:var(--aka);color:#fff4ea}
.pt.w{border:1px solid var(--amber);color:var(--amber)}
.pt.b{border:1px solid var(--paper-dim);color:var(--paper-dim)}
.rules{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
.rules li{padding-left:14px;position:relative}
.rules li::before{content:"";position:absolute;left:0;top:.45em;width:6px;height:6px;background:var(--amber)}
.rules b{font-family:var(--font-display);font-size:12px;font-weight:400;letter-spacing:.06em;color:var(--amber)}
@media (prefers-reduced-motion:reduce){.k:active,.act.down{transform:none}}
</style>
</head>
<body>


<div class="wrap">
  <header class="mast">
    <h1>KENDO <b>'84</b></h1>
    <p>Kendo on the dojo floor, the way it was played on 8-bit machines. Two ippon win the bout.</p>
  </header>

  <section class="tv" aria-label="Game screen">
    <div class="screen" id="screen">
      <canvas id="game" width="320" height="180" tabindex="0" aria-label="Kendo '84 game. Keyboard controls are described below the screen."></canvas>
    </div>
    <div class="deck">
      <span class="brand"><span class="led"></span>Kendo '84 · Sanbon Shobu</span>
      <div class="btns">
        <button class="k" id="bSound" type="button" aria-pressed="true">Sound</button>
        <button class="k" id="bPause" type="button">Pause</button>
        <button class="k" id="bMenu" type="button">Menu</button>
        <button class="k" id="bTrain" type="button">Training</button>
        <button class="k" id="bPad" type="button" aria-pressed="false">Touch</button>
        <button class="k" id="bFull" type="button">Fullscreen</button>
      </div>
    </div>
    <div class="pad" id="pad">
      <div class="dpad" id="dpad" aria-label="Direction pad"><span class="h"></span><span class="v"></span><span class="c"></span></div>
      <div class="side">
        <button class="k" id="tStart" type="button">Start / pause</button>
        <div class="acts">
          <button class="act t" data-k="KeyF" type="button">Men</button>
          <button class="act g" data-k="KeyG" type="button">Do</button>
        </div>
      </div>
    </div>
  </section>

  <section class="manual" aria-label="Manual">
    <div class="col">
      <h2>Controls</h2>
      <table>
        <thead><tr><th></th><th>Player 1 · Shiro</th><th>Player 2 · Aka</th></tr></thead>
        <tbody>
          <tr><td>Move</td><td><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></td><td><kbd>↑</kbd><kbd>←</kbd><kbd>↓</kbd><kbd>→</kbd></td></tr>
          <tr><td>Strike</td><td><kbd>F</kbd></td><td><kbd>K</kbd></td></tr>
          <tr><td>Do strike</td><td><kbd>G</kbd></td><td><kbd>L</kbd></td></tr>
          <tr><td>Guard</td><td>hold away, <kbd>S</kbd> for low</td><td>hold away, <kbd>↓</kbd> for low</td></tr>
        </tbody>
      </table>
      <p class="note">New to kendo? Choose <b>Training</b> in the menu or press the Training button: fourteen short lessons with a partner, from footwork and distance to every cut and guard. On touch screens the Men button works as <kbd>F</kbd> and the Do button as <kbd>G</kbd>.</p>
      <p class="note">In single-player mode both key sets control Shiro, and Space also strikes. <kbd>Enter</kbd> starts, <kbd>P</kbd> or <kbd>Esc</kbd> pauses, <kbd>Q</kbd> in pause returns to the menu, <kbd>M</kbd> mutes the sound.</p>
    </div>

    <div class="col">
      <h2>Techniques</h2>
      <ul class="moves">
        <li><span class="in">Strike</span><span class="jp">Men</span><span class="cz">straight cut to the top of the head</span><span class="pt i">men</span></li>
        <li><span class="in">↓ + strike</span><span class="jp">Kote</span><span class="cz">fast cut to the right wrist</span><span class="pt i">kote</span></li>
        <li><span class="in">↑ + strike</span><span class="jp">Tsuki</span><span class="cz">thrust to the throat, only the very tip counts</span><span class="pt i">tsuki</span></li>
        <li><span class="in">Fwd + strike</span><span class="jp">Tobikomi-men</span><span class="cz">leaping men from long distance</span><span class="pt i">men</span></li>
        <li><span class="in">Back + strike</span><span class="jp">Hiki-men</span><span class="cz">men while stepping back, from close range</span><span class="pt i">men</span></li>
        <li><span class="in">Do</span><span class="jp">Do</span><span class="cz">cut to the side of the body</span><span class="pt i">do</span></li>
        <li><span class="in">Fwd + do</span><span class="jp">Kote-men</span><span class="cz">two-step combination, either cut can score</span><span class="pt i">kote · men</span></li>
        <li><span class="in">↓ + do</span><span class="jp">Harai-men</span><span class="cz">knocks the guard aside, then men</span><span class="pt i">men</span></li>
        <li><span class="in">Back + do</span><span class="jp">Hiki-do</span><span class="cz">do while stepping back, from close range</span><span class="pt i">do</span></li>
        <li><span class="in">Back</span><span class="jp">Men-uke</span><span class="cz">high guard while the opponent attacks</span><span class="pt b">men · tsuki</span></li>
        <li><span class="in">↓ + back</span><span class="jp">Do-uke</span><span class="cz">low guard while the opponent attacks</span><span class="pt b">kote · do</span></li>
      </ul>
      <p class="note">Forward means toward your opponent, back means away. Only the top third of the shinai, the monouchi, scores: from too close the cut does not count. Strike right after a guard for kaeshi-waza, or into the start of the opponent's attack for debana-waza.</p>
    </div>

    <div class="col">
      <h2>Rules</h2>
      <ul class="rules">
        <li><b>Sanbon shobu</b>: the first to take 2 ippon wins. A cut is ippon when at least 2 of the 3 referees raise their flags.</li>
        <li>A bout lasts 45 seconds. A tie goes to <b>Encho</b>: the first ippon wins. If it is still level, <b>Hantei</b>: the referees decide with their flags.</li>
        <li>Stepping out of the court is <b>Hansoku</b>. A second hansoku gives the opponent an ippon.</li>
        <li>Locked close in <b>Tsubazeriai</b>, only hiki-waza works. If nobody acts, the referee calls <b>Wakare</b> and separates you.</li>
        <li>Every win earns the next grade, from 6th kyu up to the dan grades. After every second win comes <b>Uchikomi-geiko</b>: cut each target the sensei opens.</li>
        <li>Commands: <b>Hajime</b> begin, <b>Yame</b> stop, <b>Men ari</b> point to men, <b>Nihonme</b> second point, <b>Shobu</b> deciding point, <b>Shobu ari</b> the bout is decided.</li>
      </ul>
    </div>
  </section>
</div>

<script>
(()=>{'use strict';
// ===== core =====
const W=320,H=180,GY=152,D2R=Math.PI/180;
const START_A=118,START_B=202,EDGE=16;
const cv=document.getElementById('game');
const ctx=cv.getContext('2d',{alpha:false});
ctx.imageSmoothingEnabled=false;
let C=ctx;
const rnd=(a,b)=>a+Math.random()*(b-a);
const ri=(a,b)=>Math.floor(a+Math.random()*(b-a+1));
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const pick=a=>a[Math.floor(Math.random()*a.length)];
const pad=(n,l)=>String(Math.max(0,n|0)).padStart(l,'0');
function pickW(o){let s=0;for(const k in o)s+=o[k];let r=Math.random()*s;for(const k in o){r-=o[k];if(r<=0)return k;}return Object.keys(o)[0];}
function rng(seed){let s=seed>>>0;return()=>{s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}

// ===== 5x7 bitmap font with Czech diacritics =====
const GL={A:[14,17,17,31,17,17,17],B:[30,17,17,30,17,17,30],C:[14,17,16,16,16,17,14],D:[30,17,17,17,17,17,30],E:[31,16,16,30,16,16,31],F:[31,16,16,30,16,16,16],G:[14,17,16,23,17,17,15],H:[17,17,17,31,17,17,17],I:[14,4,4,4,4,4,14],J:[7,2,2,2,2,18,12],K:[17,18,20,24,20,18,17],L:[16,16,16,16,16,16,31],M:[17,27,21,21,17,17,17],N:[17,17,25,21,19,17,17],O:[14,17,17,17,17,17,14],P:[30,17,17,30,16,16,16],Q:[14,17,17,17,21,18,13],R:[30,17,17,30,20,18,17],S:[15,16,16,14,1,1,30],T:[31,4,4,4,4,4,4],U:[17,17,17,17,17,17,14],V:[17,17,17,17,17,10,4],W:[17,17,17,21,21,21,10],X:[17,17,10,4,10,17,17],Y:[17,17,10,4,4,4,4],Z:[31,1,2,4,8,16,31],
'0':[14,17,19,21,25,17,14],'1':[4,12,4,4,4,4,14],'2':[14,17,1,2,4,8,31],'3':[31,2,4,2,1,17,14],'4':[2,6,10,18,31,2,2],'5':[31,16,30,1,1,17,14],'6':[6,8,16,30,17,17,14],'7':[31,1,2,4,8,8,8],'8':[14,17,17,14,17,17,14],'9':[14,17,17,15,1,2,12],
' ':[0,0,0,0,0,0,0],'!':[4,4,4,4,4,0,4],'.':[0,0,0,0,0,6,6],',':[0,0,0,0,6,2,4],':':[0,6,6,0,6,6,0],'-':[0,0,0,14,0,0,0],"'":[4,4,8,0,0,0,0],'?':[14,17,1,2,4,0,4],'/':[1,1,2,4,8,16,16],'+':[0,4,4,31,4,4,0],'=':[0,0,31,0,31,0,0],'>':[8,4,2,1,2,4,8],'<':[2,4,8,16,8,4,2],'(':[2,4,8,8,8,4,2],')':[8,4,2,2,2,4,8],'*':[0,4,21,14,21,4,0],'·':[0,0,0,4,0,0,0]};
const ACC={'Á':'Aa','É':'Ea','Í':'Ia','Ó':'Oa','Ú':'Ua','Ý':'Ya','Č':'Cc','Ď':'Dc','Ě':'Ec','Ň':'Nc','Ř':'Rc','Š':'Sc','Ť':'Tc','Ž':'Zc','Ů':'Ur'};
const MARK={a:[[3,-2],[2,-1]],c:[[1,-2],[3,-2],[2,-1]],r:[[2,-3],[1,-2],[3,-2],[2,-1]]};
function textW(s,k=1){return Math.max(0,[...String(s)].length*6-1)*k;}
function txt(s,x,y,col,k=1,al='l',shc){
  s=String(s).toUpperCase();const w=textW(s,k);
  if(al==='c')x-=Math.floor(w/2);else if(al==='r')x-=w;
  x=Math.round(x);y=Math.round(y);
  if(shc)raw(s,x+k,y+k,shc,k);
  raw(s,x,y,col,k);
}
function raw(s,x,y,col,k){
  const fn=typeof col==='function';
  if(!fn)C.fillStyle=col;
  for(const ch of s){
    let g=GL[ch],m=null;
    if(!g&&ACC[ch]){g=GL[ACC[ch][0]];m=MARK[ACC[ch][1]];}
    if(!g)g=GL[' '];
    for(let r=0;r<7;r++){
      const row=g[r];if(!row)continue;
      if(fn)C.fillStyle=col(r);
      let c=0;
      while(c<5){if(row&(16>>c)){let e=c;while(e<5&&(row&(16>>e)))e++;C.fillRect(x+c*k,y+r*k,(e-c)*k,k);c=e;}else c++;}
    }
    if(m){if(fn)C.fillStyle=col(0);for(const[px,py]of m)C.fillRect(x+px*k,y+py*k,k,k);}
    x+=6*k;
  }
}

// ===== sound: square-wave chip voice =====
const AU={ctx:null,master:null,on:true,nb:null,started:false};
function audioInit(){
  if(AU.ctx){if(AU.ctx.state==='suspended')AU.ctx.resume().catch(()=>{});return;}
  try{
    const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;
    AU.ctx=new AC();AU.master=AU.ctx.createGain();AU.master.gain.value=AU.on?0.55:0;AU.master.connect(AU.ctx.destination);
    const len=AU.ctx.sampleRate;AU.nb=AU.ctx.createBuffer(1,len,AU.ctx.sampleRate);const d=AU.nb.getChannelData(0);
    for(let i=0;i<len;i++)d[i]=Math.random()*2-1;
    if(typeof onAudioReady==='function')onAudioReady();
  }catch(e){AU.ctx=null;}
}
function tone(f,d,o={}){
  const a=AU.ctx;if(!a||!AU.on)return;
  const t=a.currentTime+(o.at||0),os=a.createOscillator(),g=a.createGain();
  os.type=o.type||'square';os.frequency.setValueAtTime(f,t);
  if(o.to)os.frequency.exponentialRampToValueAtTime(o.to,t+d);
  g.gain.setValueAtTime(o.v||0.06,t);g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  os.connect(g).connect(AU.master);os.start(t);os.stop(t+d+0.03);
}
function noise(d,o={}){
  const a=AU.ctx;if(!a||!AU.on)return;
  const t=a.currentTime+(o.at||0),s=a.createBufferSource();s.buffer=AU.nb;
  const fl=a.createBiquadFilter();fl.type=o.type||'bandpass';fl.frequency.setValueAtTime(o.f||1000,t);
  if(o.to)fl.frequency.exponentialRampToValueAtTime(o.to,t+d);fl.Q.value=o.q||1;
  const g=a.createGain();g.gain.setValueAtTime(o.v||0.15,t);g.gain.exponentialRampToValueAtTime(0.0001,t+d);
  s.connect(fl).connect(g).connect(AU.master);s.start(t,Math.random()*0.5);s.stop(t+d+0.03);
}
const SFX={
  swish(){noise(0.09,{v:0.12,f:1500,to:5000,q:0.8});},
  heavy(){noise(0.14,{v:0.15,f:800,to:4200,q:0.7});},
  // the dry bamboo crack of a clean cut
  men(){noise(0.05,{v:0.55,f:3000,type:'highpass',q:0.7});tone(1500,0.035,{v:0.07});tone(980,0.05,{type:'triangle',v:0.08,at:0.01});},
  // shinai meeting shinai
  clack(){tone(2100,0.03,{v:0.05});tone(2950,0.025,{v:0.04,at:0.008});noise(0.035,{v:0.12,f:4200,q:2});},
  // fumikomi: the stamp of the front foot
  fumi(){noise(0.14,{v:0.42,f:260,to:90,type:'lowpass'});tone(88,0.12,{type:'triangle',v:0.16,to:50});},
  kiai(hi){tone(hi?360:290,0.2,{type:'sawtooth',v:0.06,to:hi?640:540});},
  point(){[523,659,784].forEach((f,i)=>tone(f,0.12,{v:0.05,at:i*0.07}));},
  ippon(){[523,659,784,1047].forEach((f,i)=>tone(f,0.18,{v:0.06,at:i*0.08}));},
  taiko(){tone(118,0.55,{type:'sine',v:0.4,to:58});noise(0.22,{v:0.28,f:200,to:60,type:'lowpass'});tone(118,0.45,{type:'sine',v:0.25,to:58,at:0.32});noise(0.18,{v:0.2,f:200,to:60,type:'lowpass',at:0.32});},
  flag(){noise(0.09,{v:0.09,f:1600,to:500,q:0.6});},
  select(){tone(660,0.05,{v:0.05});tone(990,0.07,{v:0.05,at:0.05});},
  tick(){tone(1250,0.03,{v:0.04});},
  miss(){tone(330,0.12,{type:'triangle',v:0.08,to:200});}
};
const NF=n=>{const m={C:-9,D:-7,E:-5,F:-4,G:-2,A:0,B:2};return 440*Math.pow(2,(m[n[0]]+(n[1]==='#'?1:0)+(+n[n.length-1]-4)*12)/12);};
function play(seq,bpm,type,v){
  if(!AU.ctx)return;const b=60/bpm;let t=0;
  for(const s of seq.split(' ')){const[n,l]=s.split(':');const len=(+l||1)*b;if(n!=='-')tone(NF(n),len*0.9,{type,v,at:t});t+=len;}
}
const TUNES={
  title(){
    play('E5:1 G5:1 A5:2 G5:1 E5:1 D5:2 E5:1 D5:1 C5:1 A4:1 C5:2 D5:2 E5:1 G5:1 A5:2 C6:1 A5:1 G5:2 E5:1 D5:1 E5:4',210,'square',0.04);
    play('A2:4 A2:4 F2:4 G2:4 A2:4 C3:4 G2:4 A2:4',210,'triangle',0.09);
  },
  win(){play('C5:1 E5:1 G5:1 C6:3 G5:1 C6:5',280,'square',0.05);play('C3:3 G2:3 C3:6',280,'triangle',0.09);},
  lose(){play('A4:2 G4:2 E4:2 D4:2 C4:2 A3:6',230,'triangle',0.1);},
  promo(){play('G4:1 C5:1 E5:1 G5:1 E5:1 G5:1 C6:5',300,'square',0.05);}
};

// ===== input =====
const keys=new Set(),vk=new Set(),pressed=new Set();
const GAME_KEYS=new Set(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','KeyW','KeyA','KeyS','KeyD','KeyF','KeyG','KeyK','KeyL','Enter','KeyP','Escape','KeyM','KeyQ']);
addEventListener('keydown',e=>{
  const tg=e.target;
  if(tg&&tg.tagName==='BUTTON'&&(e.code==='Enter'||e.code==='Space'))return;
  if(GAME_KEYS.has(e.code))e.preventDefault();
  if(!keys.has(e.code))pressed.add(e.code);
  keys.add(e.code);audioInit();
},{passive:false});
addEventListener('keyup',e=>keys.delete(e.code));
addEventListener('blur',()=>{keys.clear();vk.clear();});
const isDown=c=>keys.has(c)||vk.has(c);
const edge=(...cs)=>cs.some(c=>pressed.has(c));
const MAP1={l:['KeyA'],r:['KeyD'],u:['KeyW'],d:['KeyS'],p:['KeyF'],k:['KeyG']};
const MAP2={l:['ArrowLeft'],r:['ArrowRight'],u:['ArrowUp'],d:['ArrowDown'],p:['KeyK'],k:['KeyL']};
const MAPALL={l:['KeyA','ArrowLeft'],r:['KeyD','ArrowRight'],u:['KeyW','ArrowUp'],d:['KeyS','ArrowDown'],p:['KeyF','KeyK','Space'],k:['KeyG','KeyL']};
function readPad(map){const o={};for(const k in map){o[k]=map[k].some(isDown);o[k+'P']=map[k].some(c=>pressed.has(c));}return o;}
const ATTACK_KEYS=['KeyF','KeyG','KeyK','KeyL','Space'];

// touch pad
function setV(code,on){if(on){if(!vk.has(code))pressed.add(code);vk.add(code);}else vk.delete(code);}
const dpad=document.getElementById('dpad');
function dpadAt(e){
  const r=dpad.getBoundingClientRect(),dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2),dz=r.width*0.13;
  setV('KeyA',dx<-dz);setV('KeyD',dx>dz);setV('KeyW',dy<-dz);setV('KeyS',dy>dz);
}
dpad.addEventListener('pointerdown',e=>{e.preventDefault();audioInit();try{dpad.setPointerCapture(e.pointerId);}catch(_){}dpadAt(e);});
dpad.addEventListener('pointermove',e=>{if(e.buttons||e.pointerType==='touch')dpadAt(e);});
const dEnd=()=>['KeyA','KeyD','KeyW','KeyS'].forEach(c=>vk.delete(c));
dpad.addEventListener('pointerup',dEnd);dpad.addEventListener('pointercancel',dEnd);
document.querySelectorAll('.act').forEach(b=>{
  const c=b.dataset.k;
  b.addEventListener('pointerdown',e=>{e.preventDefault();audioInit();setV(c,true);b.classList.add('down');});
  const up=()=>{vk.delete(c);b.classList.remove('down');};
  b.addEventListener('pointerup',up);b.addEventListener('pointerleave',up);b.addEventListener('pointercancel',up);
});
document.getElementById('tStart').addEventListener('click',()=>{audioInit();pressed.add('Enter');});

// ===== kendoka skeleton (facing right, origin on the floor under the fighter, y up = negative) =====
// hip, neck, head, G = left hand on the end of the hilt, A = shinai angle in degrees (0 = forward, -90 = straight up),
// front knee/ankle/toe, back knee/ankle/toe, RH = right hand on the hilt (1) or hanging at the side (0).
// The right hand and both elbows are derived: the right hand sits on the hilt, the elbows come from a two-bone solve.
const I={H:0,N:2,HD:4,G:6,A:8,KF:9,AF:11,TF:13,KB:15,AB:17,TB:19,RH:21},NP=22;
const SL=42,GRIP=7,TSUBA=10,MONO=27,IDEAL=35,TSUKI_MIN=37; // shinai length, right hand and tsuba along it, where the monouchi starts
const BASE={H:[0,-27],N:[1,-45],HD:[2,-51],G:[7,-30],A:-14,KF:[6,-14],AF:[9,0],TF:[13,0],KB:[-5,-14],AB:[-8,-3],TB:[-5,0],RH:1};
function pose(o){const q=Object.assign({},BASE,o),a=new Array(NP);for(const k in I){const i=I[k],v=q[k];if(Array.isArray(v)){a[i]=v[0];a[i+1]=v[1];}else a[i]=v;}return a;}
const LUNGE={KF:[11,-12],AF:[15,0],TF:[19,0],KB:[-6,-13],AB:[-12,-3],TB:[-9,0]};
const RETREAT={KF:[3,-14],AF:[5,0],TF:[9,0],KB:[-7,-14],AB:[-11,-3],TB:[-8,0]};
const UPRIGHT={KF:[2,-15],AF:[3,0],TF:[7,0],KB:[-2,-15],AB:[-2,0],TB:[2,0]};
const P={
  kamae:pose({}),
  walkA:pose({H:[1,-27],KF:[7,-14],AF:[11,0],TF:[15,0],KB:[-4,-14],AB:[-6,-3],TB:[-3,0]}),
  walkB:pose({H:[0,-26.5],KF:[5,-14],AF:[8,0],TF:[12,0],KB:[-6,-14],AB:[-10,-3],TB:[-7,0]}),
  stand:pose({H:[0,-29],N:[0,-47],HD:[1,-53],G:[0,-31],A:38,RH:0,...UPRIGHT}),
  rei:pose({H:[0,-29],N:[5,-46],HD:[9,-51],G:[1,-31],A:44,RH:0,...UPRIGHT}),
  sonkyo:pose({H:[-1,-17],N:[1,-35],HD:[2,-41],G:[6,-21],A:-16,KF:[8,-11],AF:[2,-2],TF:[6,0],KB:[6,-10],AB:[-1,-2],TB:[3,0]}),
  menUp:pose({N:[0,-45],HD:[1,-51],G:[2,-51],A:-128}),
  menHit:pose({H:[3,-27],N:[6,-45],HD:[8,-50],G:[13,-49],A:4,...LUNGE}),
  koteUp:pose({H:[1,-27],N:[2,-45],HD:[3,-51],G:[6,-44],A:-70}),
  koteHit:pose({H:[3,-27],N:[5,-45],HD:[7,-51],G:[11,-41],A:18,KF:[10,-13],AF:[13,0],TF:[17,0],KB:[-6,-13],AB:[-11,-3],TB:[-8,0]}),
  doUp:pose({N:[1,-45],HD:[2,-51],G:[3,-50],A:-115}),
  doHit:pose({H:[4,-26],N:[8,-43],HD:[10,-49],G:[15,-38],A:10,...LUNGE}),
  tsukiHit:pose({H:[4,-27],N:[6,-45],HD:[7,-51],G:[17,-36],A:-12,...LUNGE}),
  harai:pose({H:[1,-27],N:[2,-45],HD:[3,-51],G:[9,-33],A:-48}),
  tsuba:pose({G:[6,-36],A:-62}),
  hikiUp:pose({H:[-1,-27],N:[-1,-45],HD:[0,-51],G:[2,-51],A:-120,...RETREAT}),
  hikiMen:pose({H:[-2,-27],N:[0,-45],HD:[1,-51],G:[10,-49],A:6,...RETREAT}),
  hikiDo:pose({H:[-2,-27],N:[1,-44],HD:[2,-50],G:[12,-38],A:12,...RETREAT}),
  guardHigh:pose({H:[-1,-27],N:[-1,-45],HD:[0,-51],G:[2,-53],A:-12}),
  guardLow:pose({H:[-1,-27],N:[0,-45],HD:[1,-51],G:[6,-32],A:50}),
  hit:pose({H:[-1,-27],N:[-4,-45],HD:[-6,-50],G:[4,-33],A:-30}),
  openMen:pose({G:[6,-30],A:30}),
  openKote:pose({G:[7,-37],A:-50}),
  openDo:pose({N:[0,-45],HD:[1,-51],G:[2,-52],A:-100})
};
function lerpP(a,b,t,o){for(let i=0;i<NP;i++)o[i]=a[i]+(b[i]-a[i])*t;}

// ===== pixel primitives (draw into C) =====
function seg(x0,y0,x1,y1,t,col){
  C.fillStyle=col;x0=Math.round(x0);y0=Math.round(y0);x1=Math.round(x1);y1=Math.round(y1);
  const dx=Math.abs(x1-x0),dy=-Math.abs(y1-y0),sx=x0<x1?1:-1,sy=y0<y1?1:-1,o=t>>1;let e=dx+dy;
  for(;;){C.fillRect(x0-o,y0-o,t,t);if(x0===x1&&y0===y1)break;const e2=2*e;if(e2>=dy){e+=dy;x0+=sx;}if(e2<=dx){e+=dx;y0+=sy;}}
}
function disc(cx,cy,r,col){
  C.fillStyle=col;cx=Math.round(cx);cy=Math.round(cy);
  for(let y=-r;y<=r;y++){const w=Math.floor(Math.sqrt(r*r-y*y+r*0.8));C.fillRect(cx-w,cy+y,w*2+1,1);}
}
// scanline polygon fill, so filled shapes stay as crisp as the rest of the pixels
function poly(pts,col){
  C.fillStyle=col;let y0=1e9,y1=-1e9;
  for(const p of pts){if(p[1]<y0)y0=p[1];if(p[1]>y1)y1=p[1];}
  const n=pts.length;
  for(let y=Math.floor(y0);y<=Math.ceil(y1);y++){
    const yc=y+0.5,xs=[];
    for(let i=0;i<n;i++){const a=pts[i],b=pts[(i+1)%n];if((a[1]<=yc&&b[1]>yc)||(b[1]<=yc&&a[1]>yc))xs.push(a[0]+(yc-a[1])*(b[0]-a[0])/(b[1]-a[1]));}
    xs.sort((p,q)=>p-q);
    for(let i=0;i+1<xs.length;i+=2){const xa=Math.round(xs[i]),xb=Math.round(xs[i+1]);C.fillRect(xa,y,Math.max(1,xb-xa),1);}
  }
}
function polyO(pts,col){for(const[dx,dy]of[[-1,0],[1,0],[0,-1],[0,1]])poly(pts.map(p=>[p[0]+dx,p[1]+dy]),OUT);poly(pts,col);}
function segO(a,b,t,col){seg(a[0],a[1],b[0],b[1],t+2,OUT);seg(a[0],a[1],b[0],b[1],t,col);}
const OUT='#130f17',SKIN='#e3a877',SKIN2='#b27a52';
const ARM='#252e58',ARM2='#4d5d9e',ARMD='#181d3a',GRILL='#d3d8e2',GRILL2='#8c92a3';
const PALS={
  shiro:{gi:'#ecebe4',gi2:'#a9aab8',hk:'#e2e0d8',hk2:'#9e9fae',do:'#1b1920',doHi:'#56526a',tas:'#f8f5ec'},
  aka:{gi:'#3e4f97',gi2:'#26316a',hk:'#34448a',hk2:'#212b5c',do:'#a8281f',doHi:'#e65443',tas:'#e8402c'},
  sensei:{gi:'#2d3352',gi2:'#1b1f36',hk:'#272c47',hk2:'#171a2e',do:'#1b1920',doHi:'#56526a',tas:null}
};

// two-bone arm: the elbow bends down and toward the opponent
function elbow(S,T,s){
  const vx=T[0]-S[0],vy=T[1]-S[1],D=Math.hypot(vx,vy)||1,a=9;
  const mx=(S[0]+T[0])/2,my=(S[1]+T[1])/2;
  if(D>=2*a-0.3)return[mx,my];
  const h=Math.sqrt(a*a-D*D/4);let px=-vy/D,py=vx/D;
  if(py+px*s*0.6<0){px=-px;py=-py;}
  return[mx+px*h,my+py*h];
}
function fist(p,col){const x=Math.round(p[0]),y=Math.round(p[1]);C.fillStyle=OUT;C.fillRect(x-3,y-3,6,6);C.fillStyle=col;C.fillRect(x-2,y-2,4,4);}
function drawShinai(gx,gy,dx,dy,fl){
  const at=t=>[gx+dx*t,gy+dy*t],e=at(SL),b=at(-2);
  seg(b[0],b[1],e[0],e[1],4,OUT);
  let p0=at(-1),p1=at(TSUBA-1);seg(p0[0],p0[1],p1[0],p1[1],2,fl?'#fff':'#efe7d2');
  p0=at(TSUBA+1);p1=at(SL-4);seg(p0[0],p0[1],p1[0],p1[1],2,fl?'#fff':'#d6be76');
  p0=at(SL-3);seg(p0[0],p0[1],e[0],e[1],2,fl?'#fff':'#f6f1e4');
  const n=at(SL*0.74);C.fillStyle=fl?'#fff':'#f6f1e4';C.fillRect(Math.round(n[0])-1,Math.round(n[1])-1,2,2);
  const tb=at(TSUBA),qx=-dy,qy=dx;
  seg(tb[0]-qx*3,tb[1]-qy*3,tb[0]+qx*3,tb[1]+qy*3,3,OUT);seg(tb[0]-qx*2,tb[1]-qy*2,tb[0]+qx*2,tb[1]+qy*2,1,fl?'#fff':'#5a4430');
}
// sword in world space for a fighter and a pose
function swordOf(f,p,x,y){
  const a=p[I.A]*D2R;
  return{gx:x+f.facing*p[I.G],gy:GY-y+p[I.G+1],dx:f.facing*Math.cos(a),dy:Math.sin(a)};
}

function drawFighter(f){
  const p=f.cur,s=f.facing,bx=f.x,by=GY-f.y,pal=f.pal;
  const bob=(f.st==='idle'&&!f.close)?(Math.floor(f.t/26)%2):0;
  const fl=f.flash>0&&(f.flash&2);
  const c=col=>fl?'#ffffff':col;
  const pt=i=>[bx+s*p[i],by+p[i+1]+(i<=I.G?bob:0)];
  const H_=pt(I.H),N_=pt(I.N),HD_=pt(I.HD),G_=pt(I.G);
  const ang=p[I.A]*D2R,dx=s*Math.cos(ang),dy=Math.sin(ang);
  const grip=[G_[0]+dx*GRIP,G_[1]+dy*GRIP],hang=[bx+s*(p[I.H]+2),by+p[I.H+1]+3],rh=p[I.RH];
  const FH=[hang[0]+(grip[0]-hang[0])*rh,hang[1]+(grip[1]-hang[1])*rh];
  const KF=pt(I.KF),AF=pt(I.AF),TF=pt(I.TF),KB=pt(I.KB),AB=pt(I.AB),TB=pt(I.TB);
  let ux=N_[0]-H_[0],uy=N_[1]-H_[1];const ul=Math.hypot(ux,uy)||1;ux/=ul;uy/=ul;
  let nx=-uy,ny=ux;if(nx*s<0){nx=-nx;ny=-ny;}
  const T=(a,b)=>[H_[0]+ux*a+nx*b,H_[1]+uy*a+ny*b];
  const SB=T(16,-2),SF=T(16,1),EB=elbow(SB,G_,s),EF=elbow(SF,FH,s);
  // far leg, then the hakama skirt, then the near leg over it
  segO(H_,KB,6,c(pal.hk2));segO(KB,AB,5,c(pal.hk2));segO(AB,TB,2,c(SKIN2));
  polyO([T(1,-4.5),T(1,5),[AF[0]+s*3,AF[1]-2],[AB[0]-s*3,AB[1]-2]],c(pal.hk2));
  segO(H_,KF,6,c(pal.hk));segO(KF,AF,5,c(pal.hk));segO(AF,TF,2,c(SKIN));
  // far upper arm, keikogi
  segO(SB,EB,3,c(pal.gi2));
  segO(H_,N_,7,c(pal.gi));
  // tare: the armoured apron
  polyO([T(2,-4.5),T(2,5.5),T(-8,6.5),T(-8,-4)],c(ARM));
  for(const a of[-1,-5]){const q0=T(a,-4),q1=T(a,6);seg(q0[0],q0[1],q1[0],q1[1],1,c(ARM2));}
  // do: the lacquered breastplate with its leather mune on top
  polyO([T(3,-3.5),T(3,5),T(8,6.5),T(13,6),T(15.5,3.5),T(15.5,-3.5)],c(pal.do));
  poly([T(12.5,-3.5),T(12.5,6),T(15.5,3.5),T(15.5,-3.5)],c('#3d2c24'));
  {const h0=T(5,5),h1=T(11,5.5);seg(h0[0],h0[1],h1[0],h1[1],1,c(pal.doHi));const m=T(14,1);C.fillStyle=c('#c99a50');C.fillRect(Math.round(m[0]),Math.round(m[1]),1,1);}
  // mejirushi: the red or white ribbon tied to the back of the do
  if(pal.tas){
    const tp=T(13.5,-4.5),tails=[];
    for(let k=0;k<2;k++){let x=tp[0],y=tp[1];const q=[[x,y]];for(let j=1;j<=8;j++){x-=nx*(0.75+k*0.3);y+=0.7+k*0.35+Math.sin(f.t*0.16+j*0.9+k*1.9)*0.45;q.push([x,y]);}tails.push(q);}
    for(const q of tails)for(let j=1;j<q.length;j++)seg(q[j-1][0],q[j-1][1],q[j][0],q[j][1],4,OUT);
    for(const q of tails)for(let j=1;j<q.length;j++)seg(q[j-1][0],q[j-1][1],q[j][0],q[j][1],2,c(pal.tas));
    C.fillStyle=OUT;C.fillRect(Math.round(tp[0])-2,Math.round(tp[1])-2,5,5);C.fillStyle=c(pal.tas);C.fillRect(Math.round(tp[0])-1,Math.round(tp[1])-1,3,3);
  }
  // men: padded flaps, dome, steel grille, throat flap and the trailing himo cords
  const hx=Math.round(HD_[0]),hy=Math.round(HD_[1]);
  const rr=(dx0,dy0,w,h,col)=>{C.fillStyle=col;C.fillRect(s>0?hx+dx0:hx-dx0-w+1,hy+dy0,w,h);};
  polyO([[hx-s*4,hy-2],[hx+s*2,hy+3],[N_[0]+s*5,N_[1]+5],[N_[0]-s*8,N_[1]+6]],c(ARM));
  {const a0=[hx-s*5,hy+3],a1=[N_[0]-s*7,N_[1]+4];seg(a0[0],a0[1],a1[0],a1[1],1,c(ARM2));}
  disc(hx,hy,6,OUT);disc(hx,hy,5,c(ARM));
  rr(-4,-4,5,1,c(ARM2));
  rr(2,-3,4,7,c('#0c0c14'));
  for(const dy0 of[-3,-1,1,3])rr(2,dy0,Math.abs(dy0)===3?3:4,1,c(GRILL2));
  rr(6,-2,1,5,c(GRILL));rr(5,-3,1,1,c(GRILL));rr(5,3,1,1,c(GRILL));rr(4,-4,1,1,c(GRILL));rr(4,4,1,1,c(GRILL));
  rr(1,5,6,4,OUT);rr(2,5,4,2,c(ARM));
  C.fillStyle=c('#cfc5aa');
  for(let k=0;k<2;k++){let x=hx-s*5,y=hy+k;for(let j=0;j<8;j++){x-=s;y+=0.45+Math.sin(f.t*0.2+j*0.9+k*2)*0.45;C.fillRect(Math.round(x),Math.round(y),1,1);}}
  // far forearm in kote, the shinai, then the near arm over the hilt
  segO(EB,G_,3,c(ARMD));fist(G_,c(ARMD));
  drawShinai(G_[0],G_[1],dx,dy,fl);
  segO(SF,EF,3,c(pal.gi));segO(EF,FH,3,c(ARM));fist(FH,c(ARM));
  C.fillStyle=c(ARM2);C.fillRect(Math.round(FH[0])-1,Math.round(FH[1])-2,2,1);
}
function shadow(f){
  const w=Math.max(8,Math.round(24-f.y*0.45)),x=Math.round(f.x-w/2);
  C.fillStyle='rgba(0,0,0,0.33)';C.fillRect(x,GY+1,w,2);C.fillRect(x+3,GY,w-6,1);C.fillRect(x+3,GY+3,w-6,1);
}
function drawTrail(f){
  const t=f.trail;
  for(let i=1;i<t.length;i++){
    const a=(0.12+0.5*i/t.length).toFixed(2);
    seg(t[i-1][0],t[i-1][1],t[i][0],t[i][1],1,'rgba(255,246,214,'+a+')');
    seg(t[i-1][2],t[i-1][3],t[i][2],t[i][3],1,'rgba(255,246,214,'+(a*0.6).toFixed(2)+')');
  }
}

// ===== referees (front view): white flag in the screen-left hand, red in the screen-right =====
function flag(h,d,side,col){
  const e=[h[0]+d[0]*9,h[1]+d[1]*9];
  seg(h[0],h[1],e[0],e[1],3,OUT);seg(h[0],h[1],e[0],e[1],1,'#c9b48a');
  let px=-d[1],py=d[0];
  if(Math.abs(px)>0.35){if(px*side<0){px=-px;py=-py;}}else if(py<0){px=-px;py=-py;}
  const b=[e[0]-d[0]*6,e[1]-d[1]*6];
  polyO([e,b,[b[0]+px*5,b[1]+py*5],[e[0]+px*5,e[1]+py*5]],col);
}
function drawRef(r,t){
  const JK='#1f2747',TR='#74727d',cx=Math.round(r.x),gy=r.y,hip=gy-21,nk=hip-15,mode=r.mode;
  let la=0.22,ra=0.22;
  if(mode==='W')la=2.3;else if(mode==='R')ra=2.3;else if(mode==='up')la=ra=2.95;else if(mode==='hajime')la=ra=1.4;
  const sL=[cx-5,nk+2],sR=[cx+5,nk+2];
  const hand=(s0,a,d)=>[s0[0]+d*Math.sin(a)*14,s0[1]+Math.cos(a)*14];
  let hL=hand(sL,la,-1),hR=hand(sR,ra,1),dL=[-Math.sin(la),Math.cos(la)],dR=[Math.sin(ra),Math.cos(ra)];
  if(mode==='wave'){const w=(Math.floor((t+r.x)/6)%2)?2:-2;hL=[cx+2+w,nk+11];hR=[cx-2+w,nk+11];dL=[0.6,0.8];dR=[-0.6,0.8];}
  else if(mode==='wakare'){hL=[cx+2,nk+6];hR=[cx-2,nk+6];dL=[0.6,-0.8];dR=[-0.6,-0.8];}
  const eL=[(sL[0]+hL[0])/2-1,(sL[1]+hL[1])/2+1],eR=[(sR[0]+hR[0])/2+1,(sR[1]+hR[1])/2+1];
  const sg=[[cx-3,hip,cx-4,gy-1,4,TR],[cx+3,hip,cx+4,gy-1,4,TR],[cx,hip+1,cx,nk+2,10,JK],[sL[0],sL[1],eL[0],eL[1],3,JK],[eL[0],eL[1],hL[0],hL[1],3,JK],[sR[0],sR[1],eR[0],eR[1],3,JK],[eR[0],eR[1],hR[0],hR[1],3,JK]];
  for(const q of sg)seg(q[0],q[1],q[2],q[3],q[4]+2,OUT);
  disc(cx,nk-5,4,OUT);
  for(const q of sg)seg(...q);
  C.fillStyle='#eeeeea';C.fillRect(cx-1,nk-2,3,5);C.fillStyle='#b0202a';C.fillRect(cx,nk-1,1,6);
  C.fillStyle=OUT;C.fillRect(cx-7,gy-1,5,2);C.fillRect(cx+2,gy-1,5,2);
  disc(cx,nk-5,3,SKIN);C.fillStyle='#3a3238';C.fillRect(cx-3,nk-9,7,2);C.fillRect(cx-3,nk-8,1,2);C.fillRect(cx+3,nk-8,1,2);
  C.fillStyle=OUT;C.fillRect(cx-2,nk-5,1,1);C.fillRect(cx+1,nk-5,1,1);
  flag(hL,dL,-1,'#f4f1e6');flag(hR,dR,1,'#e2472f');
  C.fillStyle=SKIN;C.fillRect(Math.round(hL[0])-1,Math.round(hL[1])-1,3,3);C.fillRect(Math.round(hR[0])-1,Math.round(hR[1])-1,3,3);
}
function bubble(text,cx,y){
  const w=textW(text)+8,h=13;let x=clamp(Math.round(cx-w/2),2,W-w-2);
  C.fillStyle=OUT;C.fillRect(x-1,y-1,w+2,h+2);C.fillRect(cx-3,y+h,7,2);C.fillRect(cx-2,y+h+2,5,1);C.fillRect(cx-1,y+h+3,3,1);
  C.fillStyle='#f6efd8';C.fillRect(x,y,w,h);C.fillRect(cx-2,y+h,5,1);C.fillRect(cx-1,y+h+1,3,1);C.fillRect(cx,y+h+2,1,1);
  txt(text,x+4,y+4,OUT);
}
function slots(score,x,y,col){
  for(let i=0;i<2;i++){
    const cx=x+i*11;
    disc(cx,y,4,col);disc(cx,y,3,'#000');
    if(score>i)disc(cx,y,2,col);
  }
}
function tri(x,y,col){C.fillStyle=col;C.fillRect(x,y,1,1);C.fillRect(x-1,y+1,3,1);C.fillRect(x-2,y+2,5,1);C.fillRect(x-3,y+3,7,1);}
// ===== techniques =====
// seq: poses to blend through; dx: [from frame, to frame, distance] of footwork; win: frames in which the cut can land,
// with its target (tg) and the frame of the stamp and kiai (fx).
const MOVES={
  men:{seq:[['menUp',6],['menHit',4],['menHit',8],['kamae',10]],dx:[[3,12,22]],win:[{f0:8,f1:14,tg:'men',fx:10}],name:'MEN',heavy:1},
  kote:{seq:[['koteUp',3],['koteHit',3],['koteHit',6],['kamae',8]],dx:[[2,8,14]],win:[{f0:4,f1:9,tg:'kote',fx:6}],name:'KOTE'},
  do:{seq:[['doUp',6],['doHit',4],['doHit',8],['kamae',10]],dx:[[3,12,18]],win:[{f0:7,f1:14,tg:'do',fx:10}],name:'DO',heavy:1},
  tsuki:{seq:[['kamae',2],['tsukiHit',5],['tsukiHit',6],['kamae',14]],dx:[[1,8,16]],win:[{f0:6,f1:8,tg:'tsuki',fx:7}],name:'TSUKI'},
  tobi:{seq:[['menUp',7],['menHit',5],['menHit',8],['kamae',10]],dx:[[2,13,40]],hop:[3,13,4],win:[{f0:9,f1:15,tg:'men',fx:12}],name:'TOBIKOMI-MEN',heavy:1},
  hikimen:{seq:[['hikiUp',5],['hikiMen',4],['hikiMen',8],['kamae',9]],dx:[[2,12,-27]],win:[{f0:6,f1:12,tg:'men',fx:9}],name:'HIKI-MEN'},
  hikido:{seq:[['hikiUp',5],['hikiDo',4],['hikiDo',8],['kamae',9]],dx:[[2,12,-25]],win:[{f0:6,f1:12,tg:'do',fx:9}],name:'HIKI-DO'},
  kotemen:{seq:[['koteUp',3],['koteHit',3],['koteHit',3],['menUp',5],['menHit',4],['menHit',7],['kamae',9]],dx:[[2,7,10],[10,20,16]],win:[{f0:4,f1:8,tg:'kote',fx:6,name:'KOTE'},{f0:14,f1:20,tg:'men',fx:17,name:'KOTE-MEN'}],name:'KOTE-MEN'},
  harai:{seq:[['harai',5],['menUp',4],['menHit',4],['menHit',7],['kamae',9]],dx:[[6,16,22]],win:[{f0:11,f1:17,tg:'men',fx:13,breaks:1}],name:'HARAI-MEN',heavy:1}
};
for(const k in MOVES){const m=MOVES[k];m.total=m.seq.reduce((a,s)=>a+s[1],0);m.last=m.win[m.win.length-1].f1;}
const KIAI={men:'MEN!',kote:'KOTE!',do:'DO!',tsuki:'TSUKI!'};
const CALL={men:'MEN ARI!',kote:'KOTE ARI!',do:'DO ARI!',tsuki:'TSUKI ARI!'};
function pickMove(b,inp,tw,aw){
  if(b==='p')return inp.u?'tsuki':inp.d?'kote':tw?'tobi':aw?'hikimen':'men';
  return inp.d?'harai':tw?'kotemen':aw?'hikido':'do';
}
const ACT_STATES=new Set(['idle','walk','block']);
let moveSerial=0,kaeshiSerial=0;

class Fighter{
  constructor(side){
    this.side=side;this.pal=PALS[side];this.score=0;this.han=0;this.stats={thrown:0,hits:0,blocks:0};
    this.reset(110,1);
  }
  reset(x,f){
    Object.assign(this,{x,y:0,vx:0,facing:f,st:'idle',t:0,mv:null,mk:'',mt:0,slide:0,flash:0,walkPh:0,blockType:'high',buf:null,
      custom:null,close:false,done:[],kaeshiT:0,kaeshiOf:null,kaeshiId:0,kaeshiMove:false,trail:[],prevX:x,prevY:0});
    this.cur=P.kamae.slice();this.prev=this.cur.slice();this.tgt=P.kamae;
  }
  set(st){if(this.st!==st){this.st=st;this.t=0;}}
  canAct(){return ACT_STATES.has(this.st);}
  walkTo(goal,face,after){this.goal=clamp(goal,EDGE+10,W-EDGE-10);this.goalFace=face;this.after=after||'idle';this.mv=null;this.y=0;this.kaeshiT=0;this.buf=null;this.set('walkto');}
  // dist: when given (a counter right after a block, or the training partner), the footwork stretches or shortens
  // so the cut arrives at its own best distance
  start(key,skip=0,dist=null){
    const m=MOVES[key];this.mv=m;this.mk=key;this.mt=skip;this.done=m.win.map(()=>false);this.from=this.cur.slice();
    this.dxAdj=(dist!==null&&m.rng)?clamp(dist-m.rng[2],-26,26):0;
    this.moveId=++moveSerial;this.vx=0;this.set('attack');this.stats.thrown++;this.trail=[];
    this.kaeshiMove=this.kaeshiT>0;this.kaeshiFrom=this.kaeshiOf;this.kaeshiT=0;
  }
  // tellT: the training partner's announced attack already counts as a threat, so a held guard key guards instead of walking away
  threatens(o){return(this.tellT>0||(this.st==='attack'&&this.mv&&this.mt<=this.mv.last+2))&&Math.abs(this.x-o.x)<118;}
  control(inp,opp){
    if(inp.pP)this.buf={b:'p',t:8};else if(inp.kP)this.buf={b:'k',t:8};
    if(this.buf&&--this.buf.t<0)this.buf=null;
    if(!this.canAct())return;
    const h=(inp.r?1:0)-(inp.l?1:0),tw=h===this.facing,aw=h!==0&&h===-this.facing;
    if(this.buf){
      // right after a block the guard key is still held: it does not turn the counter into hiki-waza
      const k=this.kaeshiT>0,key=pickMove(this.buf.b,inp,tw,k?false:aw);this.buf=null;
      this.start(key,k?2:0,k?Math.abs(opp.x-this.x):null);return;
    }
    if(aw&&opp.threatens(this)){this.blockType=inp.d?'low':'high';this.set('block');return;}
    if(h){this.vx=h*(tw?1.1:0.95);this.set('walk');return;}
    this.set('idle');
  }
  update(opp,live){
    this.t++;if(this.flash>0)this.flash--;if(this.kaeshiT>0)this.kaeshiT--;if(this.tellT>0)this.tellT--;
    this.prev=this.cur.slice();this.prevX=this.x;this.prevY=this.y;
    if(live&&opp&&this.canAct()){const d=opp.x-this.x;if(Math.abs(d)>2)this.facing=d>0?1:-1;}
    this.close=!!(live&&opp&&Math.abs(opp.x-this.x)<36);
    let k=0.42;
    switch(this.st){
      case 'idle':this.tgt=this.close?P.tsuba:P.kamae;break;
      case 'walk':this.x+=this.vx;this.walkPh+=Math.abs(this.vx)*0.09;this.tgt=this.close?P.tsuba:(Math.floor(this.walkPh)%2)?P.walkA:P.walkB;k=0.35;break;
      case 'block':this.tgt=this.blockType==='low'?P.guardLow:P.guardHigh;k=0.6;break;
      case 'attack':this.runMove();break;
      case 'hit':this.tgt=P.hit;if(this.t>22)this.set('idle');break;
      case 'stand':this.tgt=P.stand;k=0.2;break;
      case 'rei':this.tgt=P.rei;k=0.16;break;
      case 'sonkyo':this.tgt=P.sonkyo;k=0.16;break;
      case 'pose':this.tgt=this.custom||P.kamae;k=0.5;break;
      case 'walkto':{
        const d=this.goal-this.x;this.facing=this.goalFace;
        if(Math.abs(d)<1.4){this.x=this.goal;this.set(this.after);}
        else{this.x+=Math.sign(d)*1.4;this.walkPh+=0.14;this.tgt=(Math.floor(this.walkPh)%2)?P.walkA:P.walkB;}
        k=0.35;break;
      }
    }
    this.x+=this.slide;this.slide*=0.82;if(Math.abs(this.slide)<0.05)this.slide=0;
    this.x=clamp(this.x,8,W-8);
    if(this.st!=='attack'){for(let i=0;i<NP;i++)this.cur[i]+=(this.tgt[i]-this.cur[i])*k;this.trail.length=0;}
    else if(this.mv&&this.mv.win.some(w=>this.mt>=w.f0-3&&this.mt<=w.f1)){
      const sw=swordOf(this,this.cur,this.x,this.y);
      this.trail.push([sw.gx+sw.dx*SL,sw.gy+sw.dy*SL,sw.gx+sw.dx*SL*0.72,sw.gy+sw.dy*SL*0.72]);if(this.trail.length>5)this.trail.shift();
    }else this.trail.length=0;
  }
  runMove(sim){
    const m=this.mv;this.mt++;
    m.dx.forEach(([f0,f1,d],j)=>{if(this.mt>f0&&this.mt<=f1)this.x+=this.facing*(d+(j?0:this.dxAdj||0))/(f1-f0);});
    if(m.hop){const[h0,h1,hh]=m.hop;this.y=(this.mt>h0&&this.mt<h1)?Math.sin(Math.PI*(this.mt-h0)/(h1-h0))*hh:0;}
    let acc=0,prev=this.from;
    for(let i=0;i<m.seq.length;i++){
      const[pn,d]=m.seq[i];
      if(this.mt<=acc+d||i===m.seq.length-1){lerpP(prev,P[pn],Math.min(1,(this.mt-acc)/d),this.cur);break;}
      acc+=d;prev=P[pn];
    }
    if(!sim){
      if(this.mt===m.win[0].f0-2)(m.heavy?SFX.heavy:SFX.swish)();
      for(const w of m.win)if(this.mt===w.fx){SFX.fumi();SFX.kiai(this.side==='shiro');kiaiText(this,KIAI[w.tg]);}
    }
    if(this.mt>=m.total){this.mv=null;this.y=0;this.set('idle');}
  }
}

// ===== cuts: where the shinai meets the target =====
function targetOf(f,tg){
  const p=f.cur,s=f.facing,bx=f.x,by=GY-f.y;let x,y,r;
  if(tg==='men'){x=p[I.HD];y=p[I.HD+1]-4;r=5;}
  else if(tg==='kote'){const a=p[I.A]*D2R;x=p[I.G]+Math.cos(a)*GRIP;y=p[I.G+1]+Math.sin(a)*GRIP;r=4;}
  else if(tg==='do'){x=(p[I.H]+p[I.N])/2+2;y=(p[I.H+1]+p[I.N+1])/2;r=6;}
  else{x=p[I.N]+2;y=p[I.N+1]+3;r=3.5;}
  return[bx+s*x,by+y,r];
}
// sweep the shinai between the last frame and this one so a fast cut cannot pass through the target
function contact(att,def,tg){
  const[tx,ty,r]=targetOf(def,tg),a=att.prev,b=att.cur,s=att.facing;
  for(let k=1;k<=4;k++){
    const u=k/4,X=att.prevX+(att.x-att.prevX)*u,Y=att.prevY+(att.y-att.prevY)*u;
    const gx=X+s*(a[I.G]+(b[I.G]-a[I.G])*u),gy=GY-Y+a[I.G+1]+(b[I.G+1]-a[I.G+1])*u;
    const an=(a[I.A]+(b[I.A]-a[I.A])*u)*D2R,dx=s*Math.cos(an),dy=Math.sin(an);
    let L=(tx-gx)*dx+(ty-gy)*dy;if(L<2)continue;if(L>SL)L=SL;
    const cx=gx+dx*L,cy=gy+dy*L;
    if(Math.hypot(tx-cx,ty-cy)<=r)return{L,x:cx,y:cy};
  }
  return null;
}
function probe(att,def){
  if(att.st!=='attack'||!att.mv)return null;
  const m=att.mv;
  for(let i=0;i<m.win.length;i++){
    const w=m.win[i];if(att.done[i]||att.mt<w.f0||att.mt>w.f1)continue;
    const c=contact(att,def,w.tg);if(!c)continue;
    att.done[i]=true;return Object.assign(c,{w,i});
  }
  return null;
}
const validL=(L,tg)=>tg==='tsuki'?L>=TSUKI_MIN:L>=MONO;
function quality(L,tg){
  if(tg==='tsuki')return clamp(0.55+(L-TSUKI_MIN)/(SL-TSUKI_MIN)*0.45,0,1);
  return clamp(1-Math.abs(L-IDEAL)/8*0.75,0.2,1);
}
function guards(def,w){
  if(def.st!=='block')return false;
  if(def.blockType==='high')return !w.breaks&&(w.tg==='men'||w.tg==='tsuki');
  return w.tg==='kote'||w.tg==='do';
}
// every technique's scoring distance, measured once against a still opponent in kamae
function measure(key){
  const att=new Fighter('shiro'),def=new Fighter('aka');let lo=0,hi=0,best=0,bq=-1;
  for(let d=12;d<=140;d++){
    att.reset(100,1);def.reset(100+d,-1);att.start(key);let q=-1;
    for(let t=0;t<90&&att.st==='attack';t++){
      att.prev=att.cur.slice();att.prevX=att.x;att.prevY=att.y;att.runMove(true);
      const r=probe(att,def);
      if(r&&validL(r.L,r.w.tg)){q=quality(r.L,r.w.tg);break;}
    }
    if(q>=0){if(!lo)lo=d;hi=d;if(q>bq){bq=q;best=d;}}
  }
  return lo?[lo,hi,best]:null;
}
for(const k in MOVES)MOVES[k].rng=measure(k);
function inRange(k,d,m=2){const r=MOVES[k].rng;return !!r&&d>=r[0]+m&&d<=r[1]-m;}
function nextWin(f){if(!f.mv)return null;for(let i=0;i<f.mv.win.length;i++){const w=f.mv.win[i];if(!f.done[i]&&f.mt<=w.f1)return w;}return null;}

// ===== CPU opponent: keeps its distance, guards, answers with kaeshi-waza and debana-waza =====
class AI{
  constructor(f,lv){this.f=f;this.lv=lv;this.next=ri(20,40);this.hold={};this.seen=0;this.react=null;this.rd=0;this.kSeen=0;this.adapt=false;this.want=ri(80,94);this.err=0;}
  input(opp){
    const f=this.f,lv=this.lv,d0=Math.abs(opp.x-f.x),d=d0+this.err; // a beginner misjudges the distance
    const inp={l:false,r:false,u:false,d:false,pP:false,kP:false};
    const tw=f.facing>0?'r':'l',aw=f.facing>0?'l':'r';
    const room=f.facing>0?f.x-EDGE:W-EDGE-f.x,oroom=opp.facing>0?opp.x-EDGE:W-EDGE-opp.x;
    if(opp.st==='attack'&&opp.moveId!==this.seen){
      this.seen=opp.moveId;
      this.react=(d0<112&&Math.random()<0.1+0.8*lv)?this.defense(opp,d0):null;
      this.rd=Math.round((1-lv)*7+Math.random()*2);
      this.adapt=Math.random()<lv;
    }
    if(opp.st!=='attack')this.react=null;
    if(this.react){
      if(this.rd>0){this.rd--;return inp;}
      else if(this.react==='deb'){this.react=null;if(f.canAct())return this.atk(inp,'kote',tw,aw);}
      else{
        let low=this.react==='lb';
        if(this.adapt){const w=nextWin(opp);if(w)low=w.tg==='kote'||w.tg==='do';}
        inp[aw]=true;inp.d=low;return inp;
      }
    }
    if(f.kaeshiT>0&&f.canAct()&&this.kSeen!==f.kaeshiId){
      this.kSeen=f.kaeshiId;
      if(Math.random()<0.1+0.45*lv){
        if(d0<96)return this.atk(inp,(f.kaeshiOf==='men'&&Math.random()<0.6)?'do':'men',tw,aw);
      }
    }
    if(this.next>0){this.next--;Object.assign(inp,this.hold);if(inp[aw]&&room<26)inp[aw]=false;return inp;}
    this.hold={};this.err=(Math.random()*2-1)*(1-lv)*14;
    const punish=(opp.st==='attack'&&opp.mv&&opp.mt>opp.mv.last)||opp.st==='hit';
    const aggr=0.07+0.22*lv;
    if(d0<36){
      const hk=['hikimen','hikido'].filter(k=>inRange(k,d,0));
      if(hk.length&&(punish||Math.random()<aggr*0.7))return this.atk(inp,pick(hk),tw,aw);
      if(oroom<44&&Math.random()<0.3+0.4*lv){this.hold[tw]=true;this.next=ri(10,24);}
      else if(room>40&&Math.random()<0.3){this.hold[aw]=true;this.next=ri(8,16);}
      else this.next=ri(10,30);
    }else{
      const wt={men:3,kote:3,do:2,tsuki:0.3+lv,kotemen:0.8+1.5*lv,harai:0.4+1.2*lv,tobi:0.7},opts={};
      let bestC=0,bestK='men';
      for(const k in wt){
        const r=MOVES[k].rng;if(!r)continue;
        const cl=1-Math.min(1,Math.abs(d-r[2])/Math.max(4,(r[1]-r[0])/2));
        if(cl>bestC){bestC=cl;bestK=k;}
        if(inRange(k,d))opts[k]=wt[k]*((1-lv)*0.6+lv*cl*cl+0.05);
      }
      if(Object.keys(opts).length&&(punish||Math.random()<aggr)){
        if(punish||lv<0.4||bestC>0.55)return this.atk(inp,pickW(opts),tw,aw);
        this.want=MOVES[bestK].rng[2];
      }
      // a strong opponent never idles inside the other's reach: it takes the initiative or slips out
      if(d0<=MOVES.kote.rng[1]+2&&Math.random()<lv*0.7){
        if(Object.keys(opts).length&&bestC>0.45)return this.atk(inp,pickW(opts),tw,aw);
        if(room>30){this.hold[aw]=true;this.next=ri(5,10);Object.assign(inp,this.hold);return inp;}
      }
      if(d>this.want+5){this.hold[tw]=true;this.next=ri(4,10);}
      else if(d<this.want-10){this.hold[room>30?aw:tw]=true;this.next=ri(4,9);}
      else{this.next=ri(8,22);const r=Math.random();if(r<0.25)this.want=ri(80,94);else if(r<0.45)this.want=ri(62,74);}
    }
    Object.assign(inp,this.hold);if(inp[aw]&&room<26)inp[aw]=false;return inp;
  }
  atk(inp,key,tw,aw){
    const map={men:['pP'],kote:['d','pP'],tsuki:['u','pP'],tobi:[tw,'pP'],hikimen:[aw,'pP'],do:['kP'],kotemen:[tw,'kP'],harai:['d','kP'],hikido:[aw,'kP']};
    for(const k of map[key])inp[k]=true;
    this.hold={};this.next=Math.round(ri(16,46)*(1-this.lv*0.5));
    return inp;
  }
  defense(opp,d){
    const lv=this.lv;
    if(((opp.mk==='harai'&&Math.random()<0.1+0.55*lv)||Math.random()<0.3*Math.max(0,lv-0.4))&&inRange('kote',d,-6))return 'deb';
    const w=nextWin(opp);return w&&(w.tg==='kote'||w.tg==='do')?'lb':'hb';
  }
}
function separate(a,b){
  const min=24,d=b.x-a.x;
  if(Math.abs(d)>=min)return;
  const dir=d>=0?1:-1,push=(min-Math.abs(d))/2;
  a.x=clamp(a.x-dir*push,8,W-8);b.x=clamp(b.x+dir*push,8,W-8);
  if(Math.abs(b.x-a.x)<min){if(a.x<=8.5||a.x>=W-8.5)b.x=a.x+dir*min;else a.x=b.x-dir*min;}
}
// ===== arenas: static layer prerendered, small animations on top =====
function mkCanvas(){const c=document.createElement('canvas');c.width=W;c.height=H;const g=c.getContext('2d');g.imageSmoothingEnabled=false;return[c,g];}
function bands(g,y0,y1,cols){const h=(y1-y0)/cols.length;cols.forEach((c,i)=>{g.fillStyle=c;g.fillRect(0,Math.round(y0+i*h),W,Math.ceil(h)+1);});}
function ridge(g,base,amp,col,seed,bottom){
  const r=rng(seed),f1=0.01+r()*0.02,f2=0.04+r()*0.03,p1=r()*6,p2=r()*6;g.fillStyle=col;
  for(let x=0;x<W;x++){const y=Math.round(base-Math.sin(x*f1+p1)*amp-Math.sin(x*f2+p2)*amp*0.35);g.fillRect(x,y,1,bottom-y);}
}
function planks(g,y0,cols,seam){
  let y=y0,h=3,i=0;
  while(y<H){
    g.fillStyle=cols[i%2];g.fillRect(0,y,W,h);g.fillStyle=seam;g.fillRect(0,y,W,1);
    const sp=26+(y-y0)*1.4,off=(i%3)*sp/3;
    for(let x=-off;x<W;x+=sp)g.fillRect(Math.round(x),y,1,h);
    y+=h;h=Math.round(h*1.2+0.6);i++;
  }
}
// shiai-jo: the white tape of the court boundary, the two start lines and the centre cross, in floor perspective
function court(g,top,col){
  const VY=40,xAt=(x0,y)=>160+(x0-160)*(y-VY)/(GY-VY);
  const line=(x0,y0,y1)=>{for(let y=Math.max(top,y0);y<=Math.min(H-1,y1);y++){const a=xAt(x0,y),b=xAt(x0,y+1),l=Math.round(Math.min(a,b)),w=Math.max(1,Math.round(Math.abs(b-a)));g.fillRect(l,y,w,1);}};
  g.fillStyle=col||'rgba(246,242,230,0.85)';
  line(EDGE,top,H);line(W-EDGE,top,H);
  line(START_A,GY-3,GY+6);line(START_B,GY-3,GY+6);
  for(let i=-2;i<=2;i++){g.fillRect(160+i,GY+2+i,1,1);g.fillRect(160+i,GY+2-i,1,1);}
}

const SCENES=[
{ // 0 dojo
  name:'DOJO',
  build(g){
    for(let x=0;x<W;x+=10){g.fillStyle=(x/10)%2?'#6e4226':'#774a2b';g.fillRect(x,0,10,128);g.fillStyle='#4a2a17';g.fillRect(x,0,1,128);}
    const r=rng(7);g.fillStyle='rgba(40,20,10,0.35)';for(let i=0;i<160;i++)g.fillRect(Math.floor(r()*W),Math.floor(r()*118),1,3+Math.floor(r()*7));
    g.fillStyle='#3b2114';g.fillRect(0,10,W,8);g.fillStyle='#5a341f';g.fillRect(0,10,W,1);
    g.fillStyle='#3b2114';g.fillRect(0,117,W,11);g.fillStyle='#22130b';g.fillRect(0,127,W,1);
    // nafuda-kake: the wooden name boards of the dojo members
    const nx=14,ny=28;
    g.fillStyle='#2a170d';g.fillRect(nx-3,ny-3,82,62);g.fillStyle='#4f2e1a';g.fillRect(nx,ny,76,56);
    g.fillStyle='#e9dfc2';g.fillRect(nx+24,ny+2,28,6);g.fillStyle='#2a1a10';for(let i=0;i<4;i++)g.fillRect(nx+27+i*6,ny+4,3,2);
    const rn=rng(19);
    for(let row=0;row<3;row++)for(let col=0;col<10;col++){
      const x=nx+4+col*7,y=ny+11+row*15;
      g.fillStyle=row===0&&col<2?'#d9b46a':'#e9dfc2';g.fillRect(x,y,5,12);
      g.fillStyle='#2a1a10';for(let k=0;k<3;k++)if(rn()<0.85)g.fillRect(x+2,y+2+k*3+Math.floor(rn()*2),1+Math.floor(rn()*2),1);
    }
    // shinai rack
    const kx=234;
    g.fillStyle='#2a170d';g.fillRect(kx,30,3,86);g.fillRect(kx+69,30,3,86);g.fillRect(kx,30,72,3);g.fillRect(kx,109,72,3);
    for(let i=0;i<9;i++){
      const x=kx+7+i*7;
      g.fillStyle='#efe7d2';g.fillRect(x,35,2,12);
      g.fillStyle='#1a120c';g.fillRect(x-1,47,4,2);
      g.fillStyle=i%3===1?'#cdb26a':'#d8c27a';g.fillRect(x,49,2,58);
      g.fillStyle='#a88f4f';for(let y=57;y<104;y+=10)g.fillRect(x,y,2,1);
      g.fillStyle='#f3eee0';g.fillRect(x,84,2,2);g.fillRect(x,105,2,2);
    }
    g.fillStyle='#3b2114';g.fillRect(kx,72,72,2);
    // tokonoma with the scroll and the small shrine
    g.fillStyle='#24140c';g.fillRect(122,20,76,97);g.fillStyle='#321c10';g.fillRect(125,23,70,94);
    g.fillStyle='#1a0f08';g.fillRect(145,27,30,2);g.fillRect(145,99,30,3);
    g.fillStyle='#e9dfc2';g.fillRect(147,29,26,70);g.fillStyle='#c7b78d';g.fillRect(147,29,26,4);g.fillRect(147,94,26,5);
    g.fillStyle='#1a1210';for(let a=0.55;a<6.05;a+=0.035){const th=a<1.4||a>5.6?1:2;g.fillRect(Math.round(160+Math.cos(a)*9),Math.round(60+Math.sin(a)*9),th,th);}
    g.fillStyle='#b8322a';g.fillRect(167,84,3,3);
    g.fillStyle='#2a1a0e';g.fillRect(150,110,20,7);g.fillStyle='#4f3a22';g.fillRect(156,104,8,6);g.fillStyle='#5d8a3e';g.fillRect(158,98,4,6);g.fillRect(155,100,10,2);
    planks(g,128,['#b67c45','#ab713d'],'#7a4a26');
    g.fillStyle='rgba(255,236,190,0.10)';g.fillRect(60,128,200,52);
    court(g,128);
  },
  init(){return{};},anim(){}
},
{ // 1 temple at sunset
  name:'TEMPLE',
  build(g){
    bands(g,0,108,['#29154e','#34195b','#461c66','#5f226e','#7f2b70','#a1376c','#c24961','#db6152','#ec7e44','#f59e3d','#f8bf55','#fad57a']);
    for(let y=-26;y<=26;y++){const yy=96+y;if(yy>108)break;const w=Math.floor(Math.sqrt(26*26-y*y));g.fillStyle=yy<80?'#ffeab0':yy<92?'#ffd27c':'#ffb95e';g.fillRect(160-w,yy,w*2+1,1);}
    for(let x=0;x<W;x++){const top=Math.round(44+Math.abs(x-78)*0.72+Math.sin(x*0.3)*1.2);if(top<108){g.fillStyle='#5a2363';g.fillRect(x,top,1,108-top);const snow=Math.round(58+Math.sin(x*0.7)*2);if(top<snow){g.fillStyle='#f1d6e7';g.fillRect(x,top,1,snow-top);}}}
    ridge(g,94,5,'#45195a',11,110);ridge(g,104,3,'#2f1146',23,112);
    g.fillStyle='#1f0b26';g.fillRect(28,66,4,44);g.fillRect(54,66,4,44);g.fillRect(22,60,42,4);g.fillRect(19,58,5,3);g.fillRect(62,58,5,3);g.fillRect(25,71,36,3);g.fillRect(41,64,4,7);
    const cx=262;g.fillStyle='#1f0b26';
    for(let k=0;k<4;k++){
      const ry=98-k*14,rw=44-k*8,bw=24-k*5;
      g.fillRect(cx-(bw>>1),ry+2,bw,12);
      for(let r=0;r<3;r++)g.fillRect(cx-rw/2+r*2,ry-r,rw-r*4,1);
      g.fillRect(cx-rw/2-2,ry-2,2,2);g.fillRect(cx+rw/2,ry-2,2,2);
    }
    g.fillRect(cx-1,40,2,18);for(let k=0;k<4;k++)g.fillRect(cx-3,44+k*4,6,1);
    g.fillStyle='#3c2238';g.fillRect(0,110,W,18);g.fillStyle='#5b3651';g.fillRect(0,110,W,2);
    g.fillStyle='#2c1829';for(let y=114;y<128;y+=5)for(let x=(y%2)*9;x<W;x+=18)g.fillRect(x,y,1,5);for(let y=114;y<128;y+=5)g.fillRect(0,y,W,1);
    g.fillStyle='#857882';g.fillRect(0,128,W,52);g.fillStyle='#a4818a';g.fillRect(0,128,W,3);
    g.fillStyle='#5e5260';let y=131,h=4;while(y<H){g.fillRect(0,y,W,1);y+=h;h=Math.round(h*1.3+1);}
    for(let k=-12;k<=12;k++){const xb=160+k*34;for(let yy=128;yy<H;yy++){const tt=(yy-40)/140;g.fillRect(Math.round(160+(xb-160)*tt),yy,1,1);}}
    court(g,128);
  },
  init(){return{birds:[0,1,2].map(i=>({x:-20-i*40,y:24+i*9,v:0.22+i*0.03})),leaves:Array.from({length:9},()=>({x:rnd(0,W),y:rnd(-60,128),v:rnd(0.2,0.45),p:rnd(0,6)}))};},
  anim(s,t){
    for(const b of s.birds){
      b.x+=b.v;if(b.x>W+10){b.x=-20-rnd(0,80);b.y=rnd(18,52);}
      const up=Math.floor((t+b.y*3)/10)%2,x=Math.round(b.x),y=Math.round(b.y);C.fillStyle='#1f0b26';
      C.fillRect(x-1,y,3,1);if(up){C.fillRect(x-3,y-1,2,1);C.fillRect(x+2,y-1,2,1);}else{C.fillRect(x-3,y+1,2,1);C.fillRect(x+2,y+1,2,1);}
    }
    for(const l of s.leaves){
      l.y+=l.v;l.x+=Math.sin(t*0.03+l.p)*0.35;if(l.y>150){l.y=-10;l.x=rnd(0,W);}
      C.fillStyle=l.p>3?'#e8642c':'#c9362a';C.fillRect(Math.round(l.x),Math.round(l.y),2,1);
    }
  }
},
{ // 2 harbour at night
  name:'HARBOUR',
  build(g){
    bands(g,0,96,['#04051a','#060823','#090c2c','#0c1236','#101942','#15214f','#1b2b5d','#22366a']);
    const r=rng(3);
    for(let i=0;i<70;i++){g.fillStyle=r()<0.3?'#d6dcff':'#7f88c4';g.fillRect(Math.floor(r()*W),Math.floor(r()*62),1,1);}
    const prev=C;C=g;disc(252,24,12,'#1a2758');disc(252,24,9,'#f3edd2');C=prev;
    g.fillStyle='#d6cfae';g.fillRect(249,21,2,2);g.fillRect(254,27,3,2);g.fillRect(256,20,1,1);
    let x=0;while(x<W){const w=8+Math.floor(r()*14),top=52+Math.floor(r()*26);g.fillStyle='#0d1330';g.fillRect(x,top,w,96-top);if(r()<0.3){g.fillRect(x+w/2|0,top-6,1,6);}x+=w;}
    this.win=[];x=-4;
    while(x<W){
      const w=10+Math.floor(r()*18),top=62+Math.floor(r()*24);g.fillStyle='#131b3e';g.fillRect(x,top,w,96-top);
      for(let yy=top+3;yy<93;yy+=4)for(let xx=x+2;xx<x+w-1;xx+=3)if(r()<0.3){const c=['#f7d774','#f0b04a','#fff1b8'][Math.floor(r()*3)];g.fillStyle=c;g.fillRect(xx,yy,2,2);if(r()<0.12)this.win.push([xx,yy]);}
      x+=w+1;
    }
    bands(g,96,124,['#0b1838','#0d1d42','#10224c','#132755']);
    g.fillStyle='#2a3e78';for(let i=0;i<40;i++)g.fillRect(Math.floor(r()*W),97+Math.floor(r()*26),2+Math.floor(r()*5),1);
    planks(g,124,['#5a483d','#4f3f35'],'#2a201b');
    g.fillStyle='#2a1f1a';for(let px=6;px<W;px+=32)g.fillRect(px,110,3,15);
    g.fillStyle='#7a6650';for(let px=6;px<W-32;px+=32)for(let i=0;i<32;i++)g.fillRect(px+i+1,113+Math.round(Math.sin(i/32*Math.PI)*3),1,1);
    // paper lanterns light the pier
    for(const lx of[70,250]){g.fillStyle='#2a1f1a';g.fillRect(lx,90,1,8);g.fillStyle='#130f17';g.fillRect(lx-4,97,9,12);g.fillStyle='#e8523c';g.fillRect(lx-3,98,7,10);g.fillStyle='#ffb36b';g.fillRect(lx-2,100,5,6);}
    g.fillStyle='rgba(255,170,90,0.10)';g.fillRect(0,124,W,56);
    court(g,124);
  },
  init(){return{boat:-30,sh:Array.from({length:34},()=>({x:rnd(0,W),y:ri(98,122),l:ri(2,7),p:rnd(0,6)}))};},
  anim(s,t){
    C.fillStyle='#fff6c8';
    for(let i=0;i<14;i++){const sx=(i*73+11)%W,sy=(i*37+5)%60;if(Math.sin(t*0.06+i*1.7)>0.85)C.fillRect(sx,sy,1,1);}
    const wl=SCENES[2].win||[];C.fillStyle='#131b3e';
    for(let i=0;i<wl.length;i++)if(Math.sin(t*0.013+i*2.3)>0.92)C.fillRect(wl[i][0],wl[i][1],2,2);
    s.boat+=0.06;if(s.boat>W+30)s.boat=-40;const bx=Math.round(s.boat);
    C.fillStyle='#070a1c';C.fillRect(bx,104,22,3);C.fillRect(bx+2,107,18,1);C.fillRect(bx+9,92,1,12);C.fillRect(bx+10,95,6,7);
    C.fillStyle='#f6c860';C.fillRect(bx+19,102,1,1);
    for(const w of s.sh){if(Math.sin(t*0.05+w.p)>0.2){C.fillStyle=w.p>3?'#f0b04a':'#3b56a0';C.fillRect(Math.round(w.x+Math.sin(t*0.04+w.p)*2),w.y,w.l,1);}}
  }
},
{ // 3 garden in the morning
  name:'GARDEN',
  build(g){
    bands(g,0,104,['#78c3e6','#86cae8','#95d1ea','#a6d8ec','#b8dfee','#c9e6ef','#d9ecee']);
    g.fillStyle='#f4fbff';[[40,18,26],[60,14,16],[190,26,30],[214,22,14],[120,10,18]].forEach(([x,y,w])=>{g.fillRect(x,y,w,3);g.fillRect(x+3,y-2,w-8,2);});
    ridge(g,86,5,'#93b98c',41,108);ridge(g,96,4,'#6f9f6c',42,108);
    const prev=C;C=g;
    const tree=(tx,dir)=>{
      seg(tx,128,tx+dir*6,72,6,'#4b2f2a');seg(tx+dir*5,84,tx-dir*20,58,3,'#4b2f2a');seg(tx+dir*6,76,tx+dir*30,52,3,'#4b2f2a');seg(tx+dir*6,74,tx+dir*4,44,3,'#4b2f2a');
      const r=rng(tx);
      for(const[cx,cy,rad]of[[tx-dir*20,54,13],[tx+dir*4,40,15],[tx+dir*28,48,14],[tx+dir*10,58,12]])
        for(let i=0;i<rad*rad*2.2;i++){const a=r()*6.28,d=Math.sqrt(r())*rad;g.fillStyle=['#f7bfd0','#ef9fb8','#fbe0e8','#e888a6'][Math.floor(r()*4)];g.fillRect(Math.round(cx+Math.cos(a)*d),Math.round(cy+Math.sin(a)*d*0.8),2,1);}
    };
    for(let x=0;x<W;x+=5){g.fillStyle=(x/5)%2?'#a49848':'#b6aa5a';g.fillRect(x,104,4,24);g.fillStyle='#7d7236';for(let y=110;y<128;y+=8)g.fillRect(x,y,4,1);}
    g.fillStyle='#8a7e3c';g.fillRect(0,106,W,2);g.fillRect(0,120,W,2);
    tree(36,1);tree(284,-1);
    C=prev;
    g.fillStyle='#6e6c69';g.fillRect(226,118,14,10);g.fillStyle='#8c8a86';g.fillRect(230,104,6,14);g.fillRect(224,96,18,8);g.fillStyle='#f6d68a';g.fillRect(229,98,8,4);
    g.fillStyle='#6e6c69';g.fillRect(220,92,26,4);g.fillRect(224,90,18,2);g.fillRect(232,86,2,4);
    g.fillStyle='#dcd5c4';g.fillRect(0,128,W,52);
    g.fillStyle='#c3baa6';for(let k=0;k<12;k++){const y0=130+k*4;for(let x=0;x<W;x++)g.fillRect(x,y0+Math.round(Math.sin(x*0.07+k*0.8)),1,1);}
    court(g,128,'#8a7f6b');
  },
  init(){return{p:Array.from({length:26},()=>({x:rnd(0,W),y:rnd(-40,150),v:rnd(0.18,0.4),ph:rnd(0,6)}))};},
  anim(s,t){
    for(const q of s.p){
      q.y+=q.v;q.x+=Math.sin(t*0.025+q.ph)*0.4+0.12;if(q.y>178||q.x>W+4){q.y=rnd(-30,-4);q.x=rnd(-20,W);}
      C.fillStyle=q.ph>3?'#f6b6c8':'#fbd9e4';C.fillRect(Math.round(q.x),Math.round(q.y),2,1);
      if(q.ph>4.5)C.fillRect(Math.round(q.x)+1,Math.round(q.y)-1,1,1);
    }
  }
}
];
for(const sc of SCENES){const[c,g]=mkCanvas();sc.c=c;sc.build(g);}
let sceneState=null,sceneIdx=-1;
function enterScene(i){sceneIdx=i;sceneState=SCENES[i].init();}
function drawScene(t){C.drawImage(SCENES[sceneIdx].c,0,0);SCENES[sceneIdx].anim(sceneState,t);}
// ===== grades, state =====
const GRADES=['6TH KYU','5TH KYU','4TH KYU','3RD KYU','2ND KYU','1ST KYU','1ST DAN','2ND DAN','3RD DAN','4TH DAN','5TH DAN','6TH DAN','7TH DAN','8TH DAN'];
const rank=i=>[GRADES[Math.min(i,GRADES.length-1)],i<6?'MUDANSHA':i<11?'YUDANSHA':i===11?'RENSHI':i===12?'KYOSHI':'HANSHI'];
const S={screen:'title',mode:1,menu:0,stage:0,score:0,hi:0,tally:[0,0],sceneI:0,t:0,idle:0,paused:false,demo:false,newHi:false,click:false,clickItem:null};
let M=null,B=null,R=null,FX=[];
try{S.hi=+localStorage.getItem('kendo84-hi')||0;}catch(e){}
function saveHi(){try{localStorage.setItem('kendo84-hi',String(S.hi));}catch(e){}}
function addScore(n){S.score+=n;if(S.score>S.hi){S.hi=S.score;S.newHi=true;saveHi();}}
const RB=['#ffe28a','#ffc061','#ff9a4a','#f2703f','#d9483a','#b23045','#80284e'];
const rainbow=t=>r=>RB[(r+Math.floor(t/5))%RB.length];

const TA=new Fighter('shiro'),TB=new Fighter('aka');
function resetTitle(){TA.reset(62,1);TB.reset(258,-1);for(const f of[TA,TB]){f.set('idle');f.cur=P.kamae.slice();}}
function toTitle(){S.screen='title';S.t=0;S.idle=0;S.paused=false;S.demo=false;M=null;B=null;R=null;FX=[];resetTitle();enterScene(1);if(AU.ctx)TUNES.title();}
function onAudioReady(){if(S.screen==='title')TUNES.title();}

// ===== match flow =====
function startGame(mode){S.mode=mode;S.stage=0;S.score=0;S.newHi=false;S.tally=[0,0];S.sceneI=0;S.demo=false;newMatch();}
function startDemo(){S.demo=true;S.mode=1;S.stage=ri(1,6);S.sceneI=ri(0,3);newMatch();}
const mkRef=(x,y)=>({x,y,mode:'idle',mt:0});
function refMode(i,mode,dur){const r=M.refs[i];r.mode=mode;r.mt=dur;}
function allRefs(mode,dur){for(let i=0;i<3;i++)refMode(i,mode,dur);}
function newMatch(){
  const a=new Fighter('shiro'),b=new Fighter('aka');
  a.reset(START_A,1);b.reset(START_B,-1);
  for(const f of[a,b]){f.set('stand');f.cur=P.stand.slice();}
  const lv=S.demo?0.6:clamp(0.12+S.stage*0.08,0.1,0.95);
  M={a,b,ph:'intro',t:0,time:45*60,enc:false,encAnn:false,say:'',sayT:0,shake:0,pend:null,walking:false,w:null,hw:null,tsuba:0,off:null,seated:0,
     refs:[mkRef(160,GY-16),mkRef(44,GY-20),mkRef(276,GY-20)],
     aiA:S.demo?new AI(a,lv):null,aiB:(S.mode===1||S.demo)?new AI(b,lv):null};
  FX=[];B=null;R=null;
  enterScene(S.mode===1&&!S.demo?S.stage%4:S.sceneI%4);
  S.screen='match';S.paused=false;
}
function say(text,dur){M.say=text;M.sayT=dur;}
const colorOf=f=>f.side==='shiro'?'W':'R';
const nameOf=f=>f.side==='shiro'?'SHIRO':'AKA';
function updMatch(){
  const a=M.a,b=M.b;M.t++;
  if(S.demo&&(pressed.size||S.click)){toTitle();return;}
  if(M.sayT>0)M.sayT--;
  for(const r of M.refs)if(r.mt>0&&--r.mt===0)r.mode='idle';
  if(M.shake>0){M.shake*=0.86;if(M.shake<0.4)M.shake=0;}
  switch(M.ph){
    case 'intro':
      if(M.t===14){say('REI!',46);a.set('rei');b.set('rei');}
      if(M.t===58){a.set('stand');b.set('stand');}
      if(M.t===76){a.set('sonkyo');b.set('sonkyo');}
      if(M.t===118){say('SANBON SHOBU HAJIME!',64);refMode(0,'hajime',40);SFX.taiko();a.set('idle');b.set('idle');}
      if(M.t>=142){M.ph='fight';M.t=0;}
      break;
    case 'fight':{
      if(M.time>0)M.time--;
      if(M.time>0&&M.time<=300&&M.time%60===0)SFX.tick();
      const ia=M.aiA?M.aiA.input(b):readPad(S.mode===1?MAPALL:MAP1);
      const ib=M.aiB?M.aiB.input(a):readPad(MAP2);
      a.control(ia,b);b.control(ib,a);
      break;}
    case 'hitstop':
      if(M.t>=10){M.ph='award';M.t=0;award();}
      return;
    case 'award':if(M.t>=92)afterAward();break;
    case 'yame':
      if(M.t>=44){
        const f=M.off,o=f===a?b:a;
        if(f.han>=2){say('HANSOKU NIKAI!',96);allRefs(colorOf(o),96);SFX.flag();}
        else{say('HANSOKU IKKAI!',96);refMode(0,'wave',60);}
        M.ph='hansoku';M.t=0;
      }
      break;
    case 'hansoku':
      if(M.t>=96){
        const f=M.off,o=f===a?b:a;
        if(f.han>=2){f.han=0;o.score++;SFX.ippon();if(o.score>=2||M.enc){win(o);break;}}
        goReturn();
      }
      break;
    case 'wakare':
      if(M.t>30&&a.st==='idle'&&b.st==='idle'){say('HAJIME!',36);refMode(0,'hajime',24);M.ph='resume';M.t=0;}
      break;
    case 'return':
      if(!M.walking&&a.canAct()&&b.canAct()){M.walking=true;a.walkTo(START_A,1);b.walkTo(START_B,-1);}
      if(M.walking&&a.st==='idle'&&b.st==='idle'&&M.t>30){
        const call=M.enc?'ENCHO HAJIME!':(a.score===1&&b.score===1)?'SHOBU!':(a.score+b.score>0)?'NIHONME!':'HAJIME!';
        say(call,50);refMode(0,'hajime',30);
        if(M.encAnn){SFX.taiko();M.encAnn=false;}
        M.ph='resume';M.t=0;
      }
      break;
    case 'resume':if(M.t>=32){M.ph='fight';M.t=0;}break;
    case 'timeup':if(M.t>=64)decideTime();break;
    case 'hantei':if(M.t>=110)win(M.hw);break;
    case 'win':
      if(!M.seated&&a.st==='sonkyo'&&b.st==='sonkyo'&&M.t>50)M.seated=M.t;
      if(M.seated){
        const k=M.t-M.seated;
        if(k===50){a.set('stand');b.set('stand');}
        if(k===80){a.set('rei');b.set('rei');}
        if(k===124){a.set('stand');b.set('stand');}
        if(k>=146){endMatch();return;}
      }
      if(M.t>460){endMatch();return;}
      break;
  }
  const live=M.ph==='fight';
  a.update(b,live);b.update(a,live);
  if(M.ph!=='intro'&&M.ph!=='win')separate(a,b);
  if(M.ph==='fight'){
    checkHits();
    if(M.ph==='fight')checkJogai();
    if(M.ph==='fight')checkTsuba();
    if(M.ph==='fight'&&M.time<=0){M.ph='timeup';M.t=0;say('YAME!',60);refMode(0,'up',50);SFX.taiko();}
  }
}
function judge(att,def,r){
  if(guards(def,r.w)){
    SFX.clack();spark(r.x,r.y,'block');att.slide=-att.facing*1.3;def.slide=-def.facing*0.8;
    def.kaeshiT=22;def.kaeshiOf=r.w.tg;def.kaeshiId=++kaeshiSerial;def.stats.blocks++;return 'block';
  }
  if(!validL(r.L,r.w.tg)){SFX.clack();spark(r.x,r.y,'block');if(Math.random()<0.5)refMode(0,'wave',28);popText('TOO CLOSE',clamp(att.x,40,W-40),GY-74,'#a69c88',44);return 'jam';}
  return 'valid';
}
function techName(att,def,w){
  const base=w.name||att.mv.name,simple=!w.name&&['men','kote','do','tsuki'].includes(att.mk);
  if(simple&&def.st==='attack'&&def.mv&&def.mt<def.mv.win[0].f0)return{n:'DEBANA-'+base,bonus:0.25};
  if(simple&&att.kaeshiMove){
    const n=att.kaeshiFrom==='men'&&w.tg==='do'?'KAESHI-DO':w.tg==='men'?'SURIAGE-MEN':'KAESHI-'+base;
    return{n,bonus:0.15};
  }
  return{n:base,bonus:0};
}
function checkHits(){
  const a=M.a,b=M.b,ra=probe(a,b),rb=probe(b,a);
  const ja=ra?judge(a,b,ra):null,jb=rb?judge(b,a,rb):null;
  if(ja==='valid'&&jb==='valid'){
    SFX.clack();spark(ra.x,ra.y,'hit');spark(rb.x,rb.y,'hit');
    allRefs('wave',44);popText('AIUCHI',160,GY-74,'#cfc6b2',50);return;
  }
  if(ja==='valid')cut(a,b,ra);else if(jb==='valid')cut(b,a,rb);
}
// three referees each decide whether the cut was clean; two flags make ippon
function cut(att,def,r){
  const w=r.w,tn=techName(att,def,w);
  const q=clamp(quality(r.L,w.tg)+tn.bonus,0,1),p=0.12+0.8*Math.pow(q,1.6);
  const votes=M.refs.map(()=>Math.random()<p),n=votes.filter(Boolean).length,col=colorOf(att);
  M.refs.forEach((rf,i)=>{rf.mode=votes[i]?col:'wave';rf.mt=n>=2?150:44;});
  SFX.men();SFX.flag();spark(r.x,r.y,'hit');att.stats.hits++;
  popText(tn.n,clamp(att.x,40,W-40),GY-84,'#ffe08a',70);
  if(n>=2){
    M.shake=4;def.flash=10;def.mv=null;def.set('hit');def.slide=att.facing*1.2;
    M.pend={att,def,w,bonus:tn.bonus>0};M.ph='hitstop';M.t=0;
  }else popText((n===1?'1 FLAG · ':'')+(r.L<IDEAL?'TOO CLOSE':'TOO FAR'),clamp(att.x,50,W-50),GY-74,'#a69c88',56);
}
function award(){
  const{att,w,bonus}=M.pend;att.score++;
  say(CALL[w.tg],92);SFX.ippon();
  if(S.mode===1&&!S.demo&&att===M.a){const g=bonus?1500:1000;addScore(g);popText('+'+g,clamp(att.x,30,W-30),GY-94,'#7cf06a');}
}
function afterAward(){const att=M.pend.att;M.pend=null;if(att.score>=2||M.enc)win(att);else goReturn();}
function goReturn(){M.ph='return';M.t=0;M.walking=false;M.tsuba=0;}
function checkJogai(){
  for(const f of[M.a,M.b]){
    if(f.x<EDGE||f.x>W-EDGE){
      f.han++;M.off=f;M.ph='yame';M.t=0;say('YAME!',44);refMode(0,'up',40);SFX.taiko();
      popText('JOGAI',clamp(f.x,30,W-30),GY-84,'#e2472f',60);return;
    }
  }
}
function checkTsuba(){
  const a=M.a,b=M.b;
  M.tsuba=(Math.abs(a.x-b.x)<36&&a.st!=='attack'&&b.st!=='attack')?M.tsuba+1:0;
  if(M.tsuba>240){
    M.tsuba=0;M.ph='wakare';M.t=0;say('WAKARE!',50);refMode(0,'wakare',46);
    a.walkTo(a.x-a.facing*18,a.facing);b.walkTo(b.x-b.facing*18,b.facing);
  }
}
function decideTime(){
  const a=M.a,b=M.b;
  if(a.score!==b.score){win(a.score>b.score?a:b);return;}
  if(!M.enc){M.enc=true;M.encAnn=true;M.time=30*60;say('ENCHO!',70);goReturn();return;}
  const sc=f=>f.stats.hits*3+f.stats.blocks*2+f.stats.thrown,p=0.5+clamp((sc(a)-sc(b))/24,-0.42,0.42);
  let va=0;M.refs.forEach(r=>{const v=Math.random()<p;r.mode=v?'W':'R';r.mt=110;if(v)va++;});
  M.hw=va>=2?a:b;say('HANTEI!',110);SFX.flag();M.ph='hantei';M.t=0;
}
function win(w){
  M.w=w;M.ph='win';M.t=0;M.seated=0;
  allRefs(colorOf(w),110);say('SHOBU ARI!',120);
  M.a.walkTo(START_A,1,'sonkyo');M.b.walkTo(START_B,-1,'sonkyo');
  if(S.mode===1&&!S.demo&&w!==M.a)TUNES.lose();else TUNES.win();
}
function endMatch(){
  const w=M.w;
  if(S.demo){toTitle();return;}
  if(S.mode===2){S.tally[w===M.a?0:1]++;S.sceneI++;R={kind:'tally',w:w.side,t:0};S.screen='result';return;}
  if(w===M.a){const tb=Math.ceil(M.time/60)*50;addScore(2000+tb);S.stage++;R={kind:'promo',t:0,tb};S.screen='result';TUNES.promo();}
  else{R={kind:'over',t:0};S.screen='result';}
}

// ===== effects =====
function spark(x,y,kind){
  const n=kind==='hit'?14:7;
  for(let i=0;i<n;i++){const a=Math.random()*6.283,v=rnd(0.6,2.4);FX.push({x,y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:ri(8,16),c:kind==='hit'?pick(['#ffffff','#ffe08a','#ffb347']):pick(['#cfe6ff','#ffffff'])});}
  FX.push({ring:1,x,y,l:9,c:kind==='hit'?'#ffffff':'#9cc8ff'});
}
function popText(s,x,y,c,l){FX.push({text:s,x,y,l:l||80,c:c||'#ffe08a'});}
function kiaiText(f,s){FX.push({text:s,x:clamp(f.x+f.facing*6,24,W-24),y:GY-70,l:28,c:'#fff3c4',kiai:1});}
function updFx(){for(const p of FX){p.l--;if(p.text)p.y-=p.kiai?0.25:0.3;else if(!p.ring){p.x+=p.vx;p.y+=p.vy;p.vy+=0.06;p.vx*=0.96;}}FX=FX.filter(p=>p.l>0);}
function drawFx(){
  for(const p of FX){
    if(p.text){if(p.l>12||p.l%4<2)txt(p.text,clamp(p.x,textW(p.text)/2+2,W-textW(p.text)/2-2),p.y,p.c,1,'c',OUT);}
    else if(p.ring){const r=Math.round((9-p.l)*1.6+2);C.fillStyle=p.c;for(let a=0;a<6.28;a+=0.45)C.fillRect(Math.round(p.x+Math.cos(a)*r),Math.round(p.y+Math.sin(a)*r),1,1);}
    else{C.fillStyle=p.c;C.fillRect(Math.round(p.x),Math.round(p.y),1,1);}
  }
}

// ===== HUD =====
function hud(){
  C.fillStyle='#000';C.fillRect(0,0,W,22);C.fillStyle='#2a1d44';C.fillRect(0,22,W,1);
  txt('SHIRO',6,4,'#f4f1e6');slots(M.a.score,44,7,'#f4f1e6');
  txt('AKA',W-6,4,'#e2472f',1,'r');slots(M.b.score,W-41,7,'#e2472f');
  if(M.a.han)tri(67,4,'#f39a2b');if(M.b.han)tri(W-67,4,'#f39a2b');
  const sec=Math.ceil(M.time/60),warn=sec<=5&&M.ph==='fight'&&(M.t%30<15);
  txt(pad(sec,2),160,4,warn?'#e2472f':'#f39a2b',2,'c');
  const dim='#a69c88';
  if(S.demo){txt('DEMO',6,14,dim);txt('PRESS ANY KEY',W-6,14,dim,1,'r');}
  else if(S.mode===1){txt('SCORE '+pad(S.score,6),6,14,dim);txt('HI '+pad(S.hi,6),W-6,14,dim,1,'r');}
  else{txt('WINS '+S.tally[0],6,14,dim);txt('WINS '+S.tally[1],W-6,14,dim,1,'r');}
  let cap;
  if(M.enc)cap=M.t%40<28?'ENCHO':'';
  else if(S.mode===1&&!S.demo)cap='SHIAI FOR '+rank(S.stage+1)[0];
  else cap=SCENES[sceneIdx].name;
  if(cap)txt(cap,160,170,'#f4f1e6',1,'c',OUT);
}
function renderMatch(){
  const sx=M.shake?Math.round(rnd(-M.shake,M.shake)):0,sy=M.shake?Math.round(rnd(-M.shake,M.shake)*0.5):0;
  C.save();C.translate(sx,sy);
  drawScene(S.t);
  drawRef(M.refs[1],S.t);drawRef(M.refs[2],S.t);drawRef(M.refs[0],S.t);
  shadow(M.a);shadow(M.b);
  const order=M.a.st==='attack'&&M.b.st!=='attack'?[M.b,M.a]:[M.a,M.b];
  for(const f of order){drawTrail(f);drawFighter(f);}
  drawFx();
  if(M.sayT>0)bubble(M.say,160,GY-16-62);
  C.restore();
  hud();
}

// ===== bonus: uchikomi-geiko — the sensei opens a target, cut it before it closes =====
const OPEN={men:'openMen',kote:'openKote',do:'openDo'};
function bonusDist(){
  const r=['men','kote','do'].map(k=>MOVES[k].rng).filter(Boolean);
  if(!r.length)return 72;
  const lo=Math.max(...r.map(q=>q[0])),hi=Math.min(...r.map(q=>q[1]));
  return lo<=hi?Math.round((lo+hi)/2):MOVES.men.rng[2];
}
function startBonus(){
  const f=new Fighter('shiro'),sen=new Fighter('sensei'),d=bonusDist(),home=124;
  f.reset(home,1);sen.reset(home+d,-1);f.set('idle');sen.set('pose');sen.custom=P.kamae;
  B={t:0,total:Math.min(16,8+Math.floor(S.stage/2)),n:0,hits:0,ph:'ready',pt:0,wait:30,tg:null,
     win:Math.max(16,40-S.stage*2),f,sen,home,gain:0,swing:null,shake:0,perfect:false};
  enterScene(0);S.screen='bonus';FX=[];
}
function updBonus(){
  B.t++;B.pt++;
  const f=B.f,sen=B.sen,inp=readPad(MAPALL);
  if(B.ph==='ready'){if(B.t>80){B.ph='wait';B.pt=0;B.wait=ri(16,40);}}
  else if(B.ph==='wait'||B.ph==='open'){
    if((inp.pP||inp.kP)&&f.st==='idle'){
      const h=(inp.r?1:0)-(inp.l?1:0),key=pickMove(inp.pP?'p':'k',inp,h===1,h===-1),tg=MOVES[key].win[0].tg;
      f.start(key);
      const ok=B.ph==='open'&&tg===B.tg,react=B.pt;
      B.swing={key,ok,tg,react,early:B.ph==='wait'};
      if(B.ph==='wait')B.n++;
      B.ph='strike';B.pt=0;
    }else if(B.ph==='wait'&&B.pt>=B.wait){
      if(B.n>=B.total){B.ph='done';B.pt=0;finishBonus();}
      else{B.tg=pick(['men','kote','do']);sen.custom=P[OPEN[B.tg]];B.ph='open';B.pt=0;B.n++;}
    }else if(B.ph==='open'&&B.pt>B.win){
      popText('OSOI!',sen.x,GY-84,'#e2472f',50);SFX.miss();sen.custom=P.kamae;B.ph='wait';B.pt=0;B.wait=ri(18,44);
    }
  }else if(B.ph==='strike'){
    const sw=B.swing,w=f.mv&&f.mv.win[0];
    if(w&&f.mt===w.fx){
      const[tx,ty]=targetOf(sen,sw.tg);
      if(sw.ok){
        SFX.men();spark(tx,ty,'hit');B.hits++;B.shake=3;sen.flash=8;
        const g=100+Math.round(150*clamp(1-sw.react/B.win,0,1));B.gain+=g;addScore(g);popText('+'+g,sen.x,GY-84,'#ffe08a',50);
      }else{SFX.clack();spark(tx,ty,'block');popText(sw.early?'HAYAI!':'MISS',sen.x,GY-84,'#a69c88',50);sen.custom=P.guardHigh;}
    }
    if(f.st==='idle'&&B.pt>6){sen.custom=P.kamae;f.walkTo(B.home,1,'idle');B.ph='back';B.pt=0;}
  }else if(B.ph==='back'){
    if(f.st==='idle'){B.ph='wait';B.pt=0;B.wait=ri(14,40);}
  }else if(B.ph==='done'){
    if(B.pt>170||(B.pt>50&&(edge(...ATTACK_KEYS,'Enter')||S.click))){newMatch();return;}
  }
  f.update(null,false);sen.update(null,false);updFx();
  if(B.shake>0){B.shake*=0.85;if(B.shake<0.4)B.shake=0;}
}
function finishBonus(){
  if(B.hits===B.total){B.perfect=true;addScore(2000);B.gain+=2000;SFX.ippon();}else SFX.point();
}
function renderBonus(){
  const sx=B.shake?Math.round(rnd(-B.shake,B.shake)):0;
  C.save();C.translate(sx,0);
  drawScene(S.t);
  shadow(B.sen);shadow(B.f);drawFighter(B.sen);drawTrail(B.f);drawFighter(B.f);
  if(B.ph==='open'&&S.t%10<7){
    const[tx,ty,r]=targetOf(B.sen,B.tg),rr=r+3;C.fillStyle='#f39a2b';
    for(let a=0;a<6.28;a+=0.3)C.fillRect(Math.round(tx+Math.cos(a)*rr),Math.round(ty+Math.sin(a)*rr),1,1);
  }
  drawFx();
  C.restore();
  C.fillStyle='rgba(0,0,0,0.6)';C.fillRect(0,0,W,24);
  txt('UCHIKOMI',160,5,'#f39a2b',2,'c');
  txt(Math.min(B.n,B.total)+' / '+B.total,6,9,'#f4f1e6');
  txt('SCORE '+pad(S.score,6),W-6,9,'#a69c88',1,'r');
  if(B.ph==='ready'){
    if(S.t%40<30)txt('CUT EVERY TARGET THE SENSEI OPENS',160,36,'#f4f1e6',1,'c',OUT);
  }
  if(B.ph!=='done'){
    C.fillStyle='rgba(0,0,0,0.55)';C.fillRect(0,166,W,14);
    txt('MEN = STRIKE  KOTE = DOWN+STRIKE  DO = DO BUTTON',160,169,'#cfc6b2',1,'c');
  }else{
    C.fillStyle='rgba(10,4,24,0.72)';C.fillRect(96,32,128,58);
    txt(B.hits+' / '+B.total,160,40,'#ffffff',3,'c',OUT);
    txt(B.perfect?'PERFECT!':'CLEAN CUTS',160,66,B.perfect?'#7cf06a':'#f4f1e6',1,'c',OUT);
    txt('+'+B.gain,160,78,'#ffe08a',1,'c',OUT);
  }
}

// ===== training: short guided lessons with a partner (motodachi) who stands, attacks or guards on cue =====
// k: reach = walk to the marks; maai = hold the best distance; cut = land a clean cut with one of `ok`;
// block = stop the partner's cuts; kaeshi = block, then counter at once; info = read and continue.
const LESSONS=[
  {t:'ASHI-SABAKI',k:'reach',marks:[160,104],hint:'D / A  STEP',
   txt:'Kendo moves in small sliding steps. Step toward your partner with D (or RIGHT) and away with A (or LEFT). Walk to the orange mark, then back to the start.'},
  {t:'MAAI',k:'maai',tech:'men',hint:'D / A  STEP',
   txt:'A cut only scores from the right distance, the maai. Step until the white marker in the bar below sits on the bright green, then stand still for a moment.'},
  {t:'MEN',k:'cut',ok:['men'],tech:'men',need:2,hint:'F  MEN',
   txt:'Press F to cut MEN, the top of the head. Only the top third of the shinai, the monouchi, counts. Step into the bright green first, then cut.'},
  {t:'KOTE',k:'cut',ok:['kote'],tech:'kote',need:2,hint:'S + F  KOTE',
   txt:'Hold DOWN (S) and press F to cut KOTE, the right wrist. It is the fastest cut, and you can make it from a little further away than men.'},
  {t:'DO',k:'cut',ok:['do'],tech:'do',need:2,hint:'G  DO',
   txt:'Press G to cut DO, the side of the body. You raise the shinai as for men, turn the wrists and cut through at waist height.'},
  {t:'TSUKI',k:'cut',ok:['tsuki'],tech:'tsuki',need:1,hint:'W + F  TSUKI',
   txt:'Hold UP (W) and press F to thrust TSUKI at the throat. Only the very tip counts, and a miss leaves you open for a long moment.'},
  {t:'TOBIKOMI-MEN',k:'cut',ok:['tobi'],tech:'tobi',need:1,start:94,hint:'D + F  TOBIKOMI-MEN',
   txt:'From outside the normal reach, hold FORWARD (D) and press F. You leap in with TOBIKOMI-MEN and cover a long distance in one move.'},
  {t:'KOTE-MEN',k:'cut',ok:['kotemen'],tech:'kotemen',need:1,hint:'D + G  KOTE-MEN',
   txt:'Hold FORWARD and press G for KOTE-MEN: kote and men in one flowing move. If the first cut does not score, the second still can.'},
  {t:'MEN-UKE',k:'block',atk:['men'],need:2,hint:'HOLD A  HIGH GUARD',
   txt:'Now your partner attacks MEN. When the ! appears, hold BACK (A). Your shinai rises over your head and stops the cut.'},
  {t:'DO-UKE',k:'block',atk:['kote','do'],need:2,hint:'HOLD A + S  LOW GUARD',
   txt:'The high guard leaves kote and do open. Against those cuts hold BACK and DOWN together (A + S) for the low guard.'},
  {t:'KAESHI-WAZA',k:'kaeshi',atk:['men'],need:1,hint:'HOLD A, THEN G OR F',
   txt:'Block the men, then strike at once: G for KAESHI-DO or F for SURIAGE-MEN. You can keep holding A. A counter right after a block scores extra.'},
  {t:'HARAI-MEN',k:'cut',ok:['harai'],tech:'harai',need:1,guard:1,hint:'S + G  HARAI-MEN',
   txt:'Your partner now holds a high guard that stops every men. Hold DOWN and press G: HARAI-MEN knocks the shinai aside, then cuts men.'},
  {t:'HIKI-WAZA',k:'cut',ok:['hikimen','hikido'],tech:'hikimen',need:1,start:28,hint:'A + F  HIKI-MEN',
   txt:'Pressed together, the swords lock in tsubazeriai and normal cuts are too close. Hold BACK and press F (or G) to cut while stepping away.'},
  {t:'SHIAI',k:'info',hint:'F  FINISH',
   txt:'In a bout two ippon win, and an ippon needs 2 of the 3 referee flags. Stepping out of the white tape is hansoku. Now go and earn your grades.'}
];
let T=null;
function wrapText(s,n){const out=[];let line='';for(const w of s.split(' ')){if(line&&(line+' '+w).length>n){out.push(line);line=w;}else line=line?line+' '+w:w;}if(line)out.push(line);return out;}
function startTraining(){T={i:0};S.screen='train';S.paused=false;S.demo=false;M=null;B=null;R=null;enterScene(0);setupLesson(0);}
function setupLesson(i){
  const L=LESSONS[i],f=new Fighter('shiro'),p=new Fighter('sensei');
  const d=L.start||(L.k==='maai'?98:L.atk?76:86);
  let fx=Math.round(160-d/2),px=Math.round(160+d/2);
  if(L.k==='reach'){fx=104;px=250;}
  f.reset(fx,1);p.reset(px,-1);
  Object.assign(T,{i,L,f,p,ph:'go',pt:0,cnt:0,need:L.need||(L.k==='reach'?L.marks.length:1),mark:0,hold:0,
    pn:0,pnext:80,tell:0,homeF:fx,homeP:px,mvId:0,touched:false,lastSt:'idle',plast:'idle',resetT:0,note:null,
    refs:[mkRef(160,GY-16),mkRef(44,GY-20),mkRef(276,GY-20)]});
  FX=[];
}
function nextLesson(){
  if(T.i+1<LESSONS.length){setupLesson(T.i+1);return;}
  T.ph='complete';T.pt=0;T.note=null;T.f.walkTo(START_A,1,'rei');T.p.walkTo(START_B,-1,'rei');TUNES.promo();
}
function tNote(s,c){T.note=s?{s,c:c||'#ffe08a',t:90}:null;}
function tRefs(mode,dur){for(const r of T.refs){r.mode=mode;r.mt=dur;}}
function updTrain(){
  const L=T.L,f=T.f,p=T.p;T.pt++;
  if(T.note&&--T.note.t<=0)T.note=null;
  if(T.tell>0)T.tell--;
  for(const r of T.refs)if(r.mt>0&&--r.mt===0)r.mode='idle';
  if(T.ph==='complete'){
    f.update(null,false);p.update(null,false);updFx();
    if(T.pt>50&&(edge(...ATTACK_KEYS,'Enter')||S.click))toTitle();
    return;
  }
  if(edge('Enter')){SFX.select();nextLesson();return;}
  if(T.ph==='yoshi'&&T.pt>=90){nextLesson();return;}
  if(T.ph==='go'){
    if(L.k==='info'){if(edge(...ATTACK_KEYS)||S.click){SFX.select();nextLesson();return;}}
    else f.control(readPad(MAPALL),p);
    partner(L,f,p);
  }
  f.update(p,true);p.update(f,true);separate(f,p);
  if(T.ph==='go')tCheck(L,f,p);
  updFx();
}
// the partner stands in kamae, holds a guard, or attacks on a cue the player can read
function partner(L,f,p){
  if(L.guard){if(p.st==='idle'||p.st==='walk'){p.blockType='high';p.set('block');}return;}
  if(!L.atk||!p.canAct()||f.st==='walkto'||p.st==='walkto')return;
  T.pn++;
  if(T.pn===T.pnext-28){T.tell=28;p.tellT=30;SFX.tick();}
  if(T.pn>=T.pnext){const d=Math.abs(p.x-f.x);if(d<112)p.start(pick(L.atk),0,d);T.pn=0;T.pnext=ri(100,140);}
}
function tCheck(L,f,p){
  if(f.st==='attack'&&f.moveId!==T.mvId){T.mvId=f.moveId;T.touched=false;}
  // the player's cut on the partner
  const r=probe(f,p);
  if(r){
    T.touched=true;const w=r.w;
    if(guards(p,w)){SFX.clack();spark(r.x,r.y,'block');f.slide=-f.facing*1.3;tNote(L.guard&&w.tg==='men'?'THE GUARD STOPS MEN · TRY S + G':'BLOCKED','#cfe6ff');}
    else if(!validL(r.L,w.tg)){SFX.clack();spark(r.x,r.y,'block');refMode0('wave',40);tNote('TOO CLOSE · ONLY THE MONOUCHI COUNTS','#ff9a7a');}
    else if(quality(r.L,w.tg)+(f.kaeshiMove?0.15:0)<0.5){SFX.clack();spark(r.x,r.y,'block');tRefs('wave',40);tNote(r.L<IDEAL?'TOO CLOSE · STEP BACK A LITTLE':'TOO FAR · STEP IN A LITTLE','#ff9a7a');}
    else{
      SFX.men();SFX.flag();spark(r.x,r.y,'hit');tRefs('W',70);p.flash=10;p.mv=null;p.set('hit');
      const good=L.k==='kaeshi'?f.kaeshiMove:!!(L.ok&&L.ok.includes(f.mk));
      if(good){T.cnt++;SFX.point();tNote(CALL[w.tg]+(T.cnt<T.need?'  '+T.cnt+' / '+T.need:''),'#7cf06a');}
      else if(L.k==='kaeshi')tNote('TOO LATE · STRIKE RIGHT AFTER THE BLOCK','#ff9a7a');
      else if(L.ok)tNote(CALL[w.tg]+' · BUT THAT WAS '+MOVES[f.mk].name,'#ffe08a');
      else tNote(CALL[w.tg],'#7cf06a');
    }
  }
  if(T.lastSt==='attack'&&f.st!=='attack'){
    if(!T.touched&&L.k!=='block')tNote('MISS · OUT OF REACH','#ff9a7a');
    if(L.k==='cut'||L.k==='kaeshi')T.resetT=36;
  }
  T.lastSt=f.st;
  // the partner's cut on the player
  const r2=probe(p,f);
  if(r2){
    if(guards(f,r2.w)){
      SFX.clack();spark(r2.x,r2.y,'block');p.slide=-p.facing*1.3;f.slide=-f.facing*0.8;
      f.kaeshiT=22;f.kaeshiOf=r2.w.tg;f.kaeshiId=++kaeshiSerial;f.stats.blocks++;
      if(L.k==='block'){T.cnt++;SFX.point();tNote(T.cnt<T.need?'GOOD BLOCK  '+T.cnt+' / '+T.need:'GOOD BLOCK','#7cf06a');}
      else if(L.k==='kaeshi')tNote('NOW STRIKE!','#ffe08a');
    }else if(validL(r2.L,r2.w.tg)){
      SFX.men();spark(r2.x,r2.y,'hit');f.flash=10;f.mv=null;f.set('hit');
      tNote((r2.w.tg==='kote'||r2.w.tg==='do')&&L.k==='block'?'LOW CUT · HOLD A + S':'HIT · HOLD A WHEN THE ! APPEARS','#ff9a7a');
    }else SFX.clack();
  }
  if(T.plast==='attack'&&p.st!=='attack'&&L.atk)T.resetT=40;
  T.plast=p.st;
  if(L.k==='reach'&&T.mark<L.marks.length&&Math.abs(f.x-L.marks[T.mark])<4){
    T.mark++;T.cnt++;SFX.point();if(T.mark<L.marks.length)tNote('GOOD · NOW BACK TO THE NEXT MARK','#7cf06a');
  }
  if(L.k==='maai'){
    const g=MOVES[L.tech].rng,d=Math.abs(p.x-f.x);
    if(Math.abs(d-g[2])<=4&&f.st==='idle'){if(++T.hold===1)tNote('HOLD STILL...','#7cf06a');if(T.hold>=45)T.cnt=1;}else T.hold=0;
  }
  if(T.resetT>0&&--T.resetT===0){f.walkTo(T.homeF,1);p.walkTo(T.homeP,-1);T.pn=0;}
  if(T.cnt>=T.need){T.ph='yoshi';T.pt=0;SFX.ippon();T.note=null;tRefs('W',90);}
}
function refMode0(mode,dur){const r=T.refs[0];r.mode=mode;r.mt=dur;}
// maai meter: where each distance falls for the current technique
function meter(tech,d){
  const g=MOVES[tech].rng;if(!g)return;
  const x0=42,x1=W-8,m0=20,m1=112,X=v=>Math.round(x0+(clamp(v,m0,m1)-m0)/(m1-m0)*(x1-x0)),y=172;
  txt('MAAI',6,171,'#a69c88');
  C.fillStyle=OUT;C.fillRect(x0-1,y-1,x1-x0+2,7);
  C.fillStyle='#5a2320';C.fillRect(x0,y,X(g[0])-x0,5);
  C.fillStyle='#2f6e3a';C.fillRect(X(g[0]),y,X(g[1])-X(g[0]),5);
  C.fillStyle='#7cf06a';C.fillRect(X(g[2]-4),y,X(g[2]+4)-X(g[2]-4),5);
  C.fillStyle='#3b3644';C.fillRect(X(g[1]),y,x1-X(g[1]),5);
  const mx=X(d);C.fillStyle=OUT;C.fillRect(mx-2,y-4,5,13);C.fillStyle='#ffffff';C.fillRect(mx-1,y-3,3,11);
}
function renderTrain(){
  const L=T.L;
  drawScene(S.t);
  drawRef(T.refs[1],S.t);drawRef(T.refs[2],S.t);drawRef(T.refs[0],S.t);
  if(L.k==='reach'&&T.mark<L.marks.length&&T.ph==='go'){
    const mx=L.marks[T.mark],b=Math.floor(S.t/8)%2;
    C.fillStyle='#f39a2b';C.fillRect(mx-6,GY+3,13,2);C.fillRect(mx-4,GY+2,9,1);C.fillRect(mx-4,GY+5,9,1);
    txt('V',mx,GY-80+b*2,'#f39a2b',1,'c',OUT);
  }
  shadow(T.p);shadow(T.f);
  const order=T.f.st==='attack'?[T.p,T.f]:[T.f,T.p];
  for(const f of order){drawTrail(f);drawFighter(f);}
  if(T.tell>0&&S.t%8<5)txt('!',T.p.x,GY-80,'#ffe08a',2,'c',OUT);
  drawFx();
  C.fillStyle='#000';C.fillRect(0,0,W,22);C.fillStyle='#2a1d44';C.fillRect(0,22,W,1);
  if(T.ph==='complete'){
    txt('TRAINING',160,4,'#f39a2b',2,'c');
    C.fillStyle='rgba(10,6,18,0.78)';C.fillRect(40,34,240,52);
    txt('TRAINING COMPLETE',160,42,'#7cf06a',2,'c');
    txt('YOU ARE READY FOR SHIAI',160,62,'#f4f1e6',1,'c');
    if(T.pt>50&&S.t%40<28)txt('ENTER = MENU',160,74,'#f39a2b',1,'c');
    return;
  }
  txt('LESSON '+(T.i+1)+'/'+LESSONS.length,6,8,'#a69c88');
  txt(L.t,160,4,'#f39a2b',2,'c');
  if(L.k!=='info')txt(Math.min(T.cnt,T.need)+' / '+T.need,W-6,8,'#f4f1e6',1,'r');
  const lines=wrapText(L.txt.toUpperCase(),51);
  C.fillStyle='rgba(10,6,18,0.8)';C.fillRect(0,23,W,6+lines.length*9);
  lines.forEach((ln,i)=>txt(ln,6,27+i*9,'#f4f1e6'));
  const ny=Math.max(64,32+lines.length*9);
  if(T.ph==='yoshi')txt('YOSHI!',160,ny+2,'#7cf06a',3,'c',OUT);
  else if(T.note&&(T.note.t>10||T.note.t%4<2))txt(T.note.s,160,ny,T.note.c,1,'c',OUT);
  C.fillStyle='rgba(10,6,18,0.85)';C.fillRect(0,159,W,21);
  txt(L.hint,6,162,'#f39a2b');txt('ENTER = SKIP',W-6,162,'#a69c88',1,'r');
  if(L.tech)meter(L.tech,Math.abs(T.p.x-T.f.x));
}

// ===== title, results, pause =====
function updTitle(){
  S.idle++;if(pressed.size||S.click)S.idle=0;
  if(edge('KeyW','ArrowUp','KeyA','ArrowLeft')&&S.menu>0){S.menu--;SFX.select();}
  if(edge('KeyS','ArrowDown','KeyD','ArrowRight')&&S.menu<2){S.menu++;SFX.select();}
  const launch=i=>{SFX.select();if(i<2)startGame(i+1);else startTraining();};
  if(S.clickItem!==null){S.menu=S.clickItem;S.clickItem=null;launch(S.menu);return;}
  if(edge('Enter','Space',...ATTACK_KEYS)){launch(S.menu);return;}
  if(S.idle>60*20){startDemo();return;}
  if(S.t%150===0){const k=TA.st==='sonkyo';TA.set(k?'idle':'sonkyo');TB.set(k?'idle':'sonkyo');}
  TA.update(null,false);TB.update(null,false);
}
function renderTitle(){
  drawScene(S.t);
  C.fillStyle='rgba(10,4,24,0.62)';C.fillRect(0,14,W,64);
  const lw=textW('KENDO',5),x0=Math.round(160-(lw+8+textW("'84",3))/2);
  txt('KENDO',x0+2,26,'#120a1e',5);
  txt('KENDO',x0,24,rainbow(S.t),5);
  txt("'84",x0+lw+8,38,'#f4f1e6',3,'l','#120a1e');
  txt('TRADITIONAL KENDO FOR 1 OR 2 PLAYERS',160,67,'#f6c06a',1,'c');
  shadow(TA);shadow(TB);drawFighter(TA);drawFighter(TB);
  C.fillStyle='rgba(10,4,24,0.72)';C.fillRect(80,86,160,64);
  ['1 PLAYER','2 PLAYERS','TRAINING'].forEach((it,i)=>{
    const y=92+i*20,sel=S.menu===i;
    txt(it,160,y,sel?'#f39a2b':'#cfc6b2',2,'c');
    if(sel&&S.t%30<20){txt('>',89,y,'#f39a2b',2,'c');txt('<',231,y,'#f39a2b',2,'c');}
  });
  if(S.t%50<34)txt('PRESS ENTER OR STRIKE',160,154,'#f4f1e6',1,'c',OUT);
  txt('HI-SCORE '+pad(S.hi,6),160,168,'#a69c88',1,'c',OUT);
}
// menjo: the grading certificate as a small hanging scroll with the dojo's red seal
function drawCert(cx,cy,grade){
  const w=124,h=40,x=cx-w/2,y=cy-h/2;
  C.fillStyle=OUT;C.fillRect(x-7,y-10,w+14,6);C.fillRect(x-7,y+h+3,w+14,6);
  C.fillStyle='#5a341f';C.fillRect(x-6,y-9,w+12,4);C.fillRect(x-6,y+h+4,w+12,4);
  C.fillStyle=OUT;C.fillRect(x-1,y-6,w+2,h+11);
  C.fillStyle='#3d6a5a';C.fillRect(x,y-5,w,h+9);
  C.fillStyle='#f3ead2';C.fillRect(x+4,y-2,w-8,h+3);
  C.fillStyle='#e2d6b6';C.fillRect(x+4,y+h,w-8,1);
  txt(grade,cx-4,cy-6,'#1d1414',2,'c');
  C.fillStyle='#b8322a';C.fillRect(x+w-20,y+h-14,11,11);
  C.fillStyle='#f3ead2';C.fillRect(x+w-18,y+h-12,3,1);C.fillRect(x+w-14,y+h-12,3,1);C.fillRect(x+w-17,y+h-10,1,4);C.fillRect(x+w-13,y+h-10,2,1);C.fillRect(x+w-18,y+h-6,7,1);C.fillRect(x+w-14,y+h-8,1,3);
}
function updResult(){
  R.t++;
  const go=R.t>40&&(edge('Enter','Space',...ATTACK_KEYS)||S.click);
  if(R.kind==='promo'){if(go||R.t>60*8){if(S.stage%2===0)startBonus();else newMatch();}}
  else if(R.kind==='tally'){if(edge('Escape','KeyQ')){toTitle();return;}if(go)newMatch();}
  else if(go&&R.t>60)toTitle();
}
function renderResult(){
  C.fillStyle='#07060c';C.fillRect(0,0,W,H);
  ['#3c1848','#2a1440','#1b1030'].forEach((c,i)=>{C.fillStyle=c;C.fillRect(0,2+i*3,W,2);C.fillRect(0,H-4-i*3,W,2);});
  const blink=S.t%40<28;
  if(R.kind==='promo'){
    const rk=rank(S.stage);
    txt('GOKAKU!',160,16,rainbow(S.t),3,'c');
    txt('GRADING PASSED',160,38,'#a69c88',1,'c');
    drawCert(160,78,rk[0]);
    txt(rk[1],160,112,'#f4f1e6',1,'c');
    txt('VICTORY +2000   TIME +'+R.tb,160,126,'#ffe08a',1,'c');
    txt('SCORE '+pad(S.score,6),160,138,'#f4f1e6',1,'c');
    if(R.t>40&&blink)txt(S.stage%2===0?'NEXT: UCHIKOMI-GEIKO · ENTER':'NEXT OPPONENT · ENTER',160,156,'#f39a2b',1,'c');
  }else if(R.kind==='over'){
    const rk=rank(S.stage);
    txt('GAME OVER',160,16,'#e2472f',3,'c');
    txt('GRADE REACHED',160,38,'#a69c88',1,'c');
    drawCert(160,78,rk[0]);
    txt(rk[1],160,112,'#f4f1e6',1,'c');
    txt('SCORE '+pad(S.score,6),160,124,'#f4f1e6',2,'c');
    if(S.newHi){if(blink)txt('NEW HI-SCORE!',160,144,'#ffe08a',1,'c');}else txt('HI-SCORE '+pad(S.hi,6),160,144,'#a69c88',1,'c');
    if(R.t>60&&blink)txt('ENTER = MENU',160,158,'#f39a2b',1,'c');
  }else{
    const sw=R.w==='shiro';
    txt('SHOBU ARI!',160,18,'#a69c88',2,'c');
    txt(sw?'SHIRO':'AKA',160,38,sw?'#f4f1e6':'#e2472f',3,'c');
    txt('SHIRO',100,70,'#f4f1e6',1,'c');txt('AKA',220,70,'#e2472f',1,'c');
    txt(String(S.tally[0]),100,84,'#f4f1e6',4,'c');txt(':',160,84,'#a69c88',4,'c');txt(String(S.tally[1]),220,84,'#e2472f',4,'c');
    if(R.t>40&&blink)txt('ENTER = NEXT BOUT',160,134,'#f39a2b',1,'c');
    txt('ESC = MENU',160,148,'#a69c88',1,'c');
  }
}
function renderPause(){
  C.fillStyle='rgba(0,0,0,0.62)';C.fillRect(0,0,W,H);
  txt('PAUSED',160,62,'#f39a2b',3,'c');
  txt('P OR ESC = RESUME',160,98,'#f4f1e6',1,'c');
  txt('Q = MENU',160,110,'#a69c88',1,'c');
}

// ===== loop =====
const bSound=document.getElementById('bSound');
function toggleSound(){AU.on=!AU.on;if(AU.master)AU.master.gain.value=AU.on?0.55:0;bSound.setAttribute('aria-pressed',String(AU.on));bSound.textContent=AU.on?'Sound':'Muted';}
const canPause=()=>(S.screen==='match'&&!S.demo)||S.screen==='train';
function update(){
  if(edge('KeyM'))toggleSound();
  if(canPause()&&edge('KeyP','Escape',...(S.screen==='match'?['Enter']:[]))){S.paused=!S.paused;SFX.select();S.click=false;return;}
  if(S.paused){if(edge('KeyQ'))toTitle();S.click=false;return;}
  S.t++;
  switch(S.screen){case 'title':updTitle();break;case 'match':updMatch();updFx();break;case 'bonus':updBonus();break;case 'result':updResult();break;case 'train':updTrain();break;}
  S.click=false;
}
function render(){
  C=ctx;
  switch(S.screen){case 'title':renderTitle();break;case 'match':renderMatch();break;case 'bonus':renderBonus();break;case 'result':renderResult();break;case 'train':renderTrain();break;}
  if(S.paused)renderPause();
}
let last=0,acc=0;const STEP=1000/60;
function frame(now){
  acc+=Math.min(250,now-last);last=now;let n=0;
  while(acc>=STEP&&n<5){update();pressed.clear();acc-=STEP;n++;}
  if(n===5)acc=0;
  render();requestAnimationFrame(frame);
}

// ===== page controls =====
const refocus=e=>{if(e&&e.detail>0){try{cv.focus({preventScroll:true});}catch(_){}}};
bSound.addEventListener('click',e=>{audioInit();toggleSound();refocus(e);});
document.getElementById('bPause').addEventListener('click',e=>{if(canPause())S.paused=!S.paused;refocus(e);});
document.getElementById('bTrain').addEventListener('click',e=>{audioInit();startTraining();refocus(e);});
document.getElementById('bMenu').addEventListener('click',e=>{toTitle();refocus(e);});
const padEl=document.getElementById('pad'),bPad=document.getElementById('bPad');
function setPad(on){padEl.classList.toggle('on',on);bPad.setAttribute('aria-pressed',String(on));}
bPad.addEventListener('click',()=>setPad(!padEl.classList.contains('on')));
try{if(matchMedia('(pointer: coarse)').matches)setPad(true);}catch(e){}
document.getElementById('bFull').addEventListener('click',e=>{
  const el=document.getElementById('screen');
  try{const p=document.fullscreenElement?document.exitFullscreen():el.requestFullscreen&&el.requestFullscreen();if(p&&p.catch)p.catch(()=>{});}catch(_){}
  refocus(e);
});
cv.addEventListener('pointerdown',e=>{
  audioInit();try{cv.focus({preventScroll:true});}catch(_){}
  const r=cv.getBoundingClientRect(),x=(e.clientX-r.left)/r.width*W,y=(e.clientY-r.top)/r.height*H;
  S.click=true;
  if(S.screen==='title'&&x>=80&&x<=240&&y>=86&&y<=150)S.clickItem=clamp(Math.floor((y-86)/21.4),0,2);
});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&canPause())S.paused=true;});
/*TEST_HOOK*/
function start(data){
  if(data&&+data.hi>S.hi)S.hi=+data.hi;
  toTitle();
  requestAnimationFrame(t=>{last=t;requestAnimationFrame(frame);});
}
try{window.claude?.hot?.snapshot?.(()=>({hi:S.hi}));}catch(e){}
window.claude?.hot?.ready?window.claude.hot.ready(start):start(window.claude?.hot?.data??{});

})();
</script>

</body>
</html>
